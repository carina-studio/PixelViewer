<Project>
    <PropertyGroup>

        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AppSuiteVersion>4.0.0.908-dev</AppSuiteVersion>
        <AvaloniaVersion>12.1.2</AvaloniaVersion>
        <AvaloniaXamlBehaviorsVersion>12.0.7</AvaloniaXamlBehaviorsVersion>
        <DotNetLibVersion>10.0.11</DotNetLibVersion>
        <Nullable>enable</Nullable>
        <RuntimeIdentifiers>win-x86;win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
        <SkiaSharpVersion>3.119.4</SkiaSharpVersion>
        <TargetFramework>net10.0</TargetFramework>

    </PropertyGroup>
</Project>