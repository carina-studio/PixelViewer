<Project>
    <PropertyGroup>

        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AppSuiteVersion>3.2.2.903-preview</AppSuiteVersion>
        <AvaloniaVersion>11.3.20</AvaloniaVersion>
        <AvaloniaXamlBehaviorsVersion>11.3.0.6</AvaloniaXamlBehaviorsVersion>
        <DotNetLibVersion>10.0.11</DotNetLibVersion>
        <Nullable>enable</Nullable>
        <RuntimeIdentifiers>win-x86;win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
        <SkiaSharpVersion>3.119.4</SkiaSharpVersion>
        <TargetFramework>net10.0</TargetFramework>

    </PropertyGroup>
</Project>