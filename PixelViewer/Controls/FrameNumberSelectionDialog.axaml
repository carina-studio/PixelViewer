<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:abControls="using:CarinaStudio.Controls"
		xmlns:asControls="using:CarinaStudio.AppSuite.Controls"
		xmlns:asXaml="using:CarinaStudio.AppSuite.Xaml"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Carina.PixelViewer.Controls.FrameNumberSelectionDialog"
		Name="dialog"
		x:CompileBindings="True"
		Classes="Dialog"
        Title="{asXaml:StringResource FrameNumberSelectionDialog.Title}"
		Width="{DynamicResource Double/FrameNumberSelectionDialog.Width}">

	<DockPanel>

		<!-- Control buttons -->
		<Border Classes="Dialog_ControlButtonsPanel">
			<StackPanel Classes="Dialog_ControlButtonsPanel">
				<Button asControls:DialogElement.ButtonRole="Control" Command="{Binding #dialog.GenerateResultCommand}" Content="{asXaml:StringResource Common.OK}"/>
				<Button asControls:DialogElement.ButtonRole="Control" Command="{Binding #dialog.Close}" Content="{asXaml:StringResource Common.Cancel}"/>
			</StackPanel>
		</Border>

		<!-- Content -->
		<Grid Classes="Dialog_ContentPanel" ColumnDefinitions="*,Auto">
			<abControls:IntegerTextBox Name="frameNumberTextBox" Classes="Dialog_TextBox" Maximum="{Binding #dialog.FrameCount}" Minimum="1" Value="{Binding #dialog.InitialFrameNumber}"/>
			<TextBlock Grid.Column="1" Margin="{DynamicResource Thickness/FrameNumberSelectionDialog.FrameCount.Margin}" Text="{Binding #dialog.FrameCount, StringFormat={}/ {0}}" VerticalAlignment="Center"/>
		</Grid>
		
	</DockPanel>
	
</Window>
