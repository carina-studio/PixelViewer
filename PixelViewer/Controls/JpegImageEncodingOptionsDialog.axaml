<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:abControls="using:CarinaStudio.Controls"
        xmlns:asControls="using:CarinaStudio.AppSuite.Controls"
        xmlns:asXaml="using:CarinaStudio.AppSuite.Xaml"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Carina.PixelViewer.Controls.JpegImageEncodingOptionsDialog"
		Name="dialog"
		x:CompileBindings="True"
		Classes="Dialog"
        Title="{asXaml:StringResource JpegImageEncodingOptionsDialog.Title}"
		Width="{DynamicResource Double/JpegImageEncodingOptionsDialog.Width}">

	<DockPanel>

		<!-- Control buttons -->
		<Border Classes="Dialog_ControlButtonsPanel">
			<StackPanel Classes="Dialog_ControlButtonsPanel">
				<Button asControls:DialogElement.ButtonRole="Control" Command="{Binding #dialog.GenerateResultCommand}" Content="{asXaml:StringResource Common.OK}"/>
				<Button asControls:DialogElement.ButtonRole="Control" Command="{Binding #dialog.Close}" Content="{asXaml:StringResource Common.Cancel}"/>
			</StackPanel>
		</Border>

		<!-- Content -->
		<StackPanel Classes="Dialog_ContentPanel">
			<abControls:FormattedTextBlock asControls:DialogElement.TextRole="LabelAboveInputControl"
			                               Arg1="{Binding #qualityLevelSlider.Value, StringFormat={}{0:F0}}"
			                               Format="{asXaml:StringResource JpegImageEncodingOptionsDialog.QualityLevel}"/>
			<Slider Name="qualityLevelSlider"
			        Maximum="100" 
			        Minimum="10" 
			        SmallChange="1" 
			        TickFrequency="10" 
			        TickPlacement="Outside"/>
		</StackPanel>

	</DockPanel>
	
</Window>
