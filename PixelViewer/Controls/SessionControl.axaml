<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:c="using:CarinaStudio"
			 xmlns:abControls="using:CarinaStudio.Controls"
			 xmlns:abConverters="using:CarinaStudio.Data.Converters"
			 xmlns:aConverters="using:Avalonia.Data.Converters"
			 xmlns:app="using:Carina.PixelViewer"
             xmlns:appControls="clr-namespace:Carina.PixelViewer.Controls"
             xmlns:appConverters="clr-namespace:Carina.PixelViewer.Data.Converters"
             xmlns:appImageRenderers="clr-namespace:Carina.PixelViewer.Media.ImageRenderers"
             xmlns:appMedia="clr-namespace:Carina.PixelViewer.Media"
			 xmlns:appViewModels="clr-namespace:Carina.PixelViewer.ViewModels"
             xmlns:as="using:CarinaStudio.AppSuite"
             xmlns:asControls="using:CarinaStudio.AppSuite.Controls"
             xmlns:asConverters="using:CarinaStudio.AppSuite.Converters"
             xmlns:asMedia="using:CarinaStudio.AppSuite.Media"
             xmlns:asXaml="using:CarinaStudio.AppSuite.Xaml"
			 xmlns:ia="using:Avalonia.Xaml.Interactivity"
             xmlns:iaCore="using:Avalonia.Xaml.Interactions.Core"
			 xmlns:sys="using:System"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Carina.PixelViewer.Controls.SessionControl"
             x:DataType="{x:Type appViewModels:Session}"
			 Background="{DynamicResource Brush/Window.Background}"
             Name="root">
	
	<!-- Resources -->
	<UserControl.Resources>
		
		<!-- Align to bytes -->
		<ContextMenu x:Key="alignToIntegerMenu" Placement="Bottom">
			<MenuItem Click="OnAlignToIntegerMenuItemClick" Tag="4">
				<MenuItem.Header>
					<abControls:FormattedTextBlock Arg1="4" Format="{asXaml:StringResource SessionControl.AlignToInteger.Value}"/>
				</MenuItem.Header>
			</MenuItem>
			<MenuItem Click="OnAlignToIntegerMenuItemClick" Tag="8">
				<MenuItem.Header>
					<abControls:FormattedTextBlock Arg1="8" Format="{asXaml:StringResource SessionControl.AlignToInteger.Value}"/>
				</MenuItem.Header>
			</MenuItem>
			<MenuItem Click="OnAlignToIntegerMenuItemClick" Tag="16">
				<MenuItem.Header>
					<abControls:FormattedTextBlock Arg1="16" Format="{asXaml:StringResource SessionControl.AlignToInteger.Value}"/>
				</MenuItem.Header>
			</MenuItem>
			<MenuItem Click="OnAlignToIntegerMenuItemClick" Tag="32">
				<MenuItem.Header>
					<abControls:FormattedTextBlock Arg1="32" Format="{asXaml:StringResource SessionControl.AlignToInteger.Value}"/>
				</MenuItem.Header>
			</MenuItem>
			<MenuItem Click="OnAlignToIntegerMenuItemClick" Tag="64">
				<MenuItem.Header>
					<abControls:FormattedTextBlock Arg1="64" Format="{asXaml:StringResource SessionControl.AlignToInteger.Value}"/>
				</MenuItem.Header>
			</MenuItem>
			<MenuItem Click="OnAlignToIntegerMenuItemClick" Tag="128">
				<MenuItem.Header>
					<abControls:FormattedTextBlock Arg1="128" Format="{asXaml:StringResource SessionControl.AlignToInteger.Value}"/>
				</MenuItem.Header>
			</MenuItem>
		</ContextMenu>

		<!-- Evaluate image dimensions -->
		<ContextMenu x:Key="evaluateImageDimensionsMenu" Placement="Bottom">
			<MenuItem Command="{Binding EvaluateImageDimensionsCommand}" CommandParameter="{x:Static appMedia:AspectRatio.Unknown}" Header="{asXaml:StringResource AspectRatio.Unknown}"/>
			<Separator/>
			<MenuItem Command="{Binding EvaluateImageDimensionsCommand}" CommandParameter="{x:Static appMedia:AspectRatio.Ratio_4x3}" Header="4:3"/>
			<MenuItem Command="{Binding EvaluateImageDimensionsCommand}" CommandParameter="{x:Static appMedia:AspectRatio.Ratio_16x9}" Header="16:9"/>
			<MenuItem Command="{Binding EvaluateImageDimensionsCommand}" CommandParameter="{x:Static appMedia:AspectRatio.Ratio_3x2}" Header="3:2"/>
			<MenuItem Command="{Binding EvaluateImageDimensionsCommand}" CommandParameter="{x:Static appMedia:AspectRatio.Ratio_1x1}" Header="1:1"/>
			<Separator/>
			<MenuItem Command="{Binding EvaluateImageDimensionsCommand}" CommandParameter="{x:Static appMedia:AspectRatio.Ratio_3x4}" Header="3:4"/>
			<MenuItem Command="{Binding EvaluateImageDimensionsCommand}" CommandParameter="{x:Static appMedia:AspectRatio.Ratio_9x16}" Header="9:16"/>
			<MenuItem Command="{Binding EvaluateImageDimensionsCommand}" CommandParameter="{x:Static appMedia:AspectRatio.Ratio_2x3}" Header="2:3"/>
		</ContextMenu>

		<!-- File actions -->
		<ContextMenu x:Key="fileActionsMenu" Placement="Top">
			<MenuItem Command="{Binding #root.CopyFileName}" Header="{asXaml:StringResource SessionControl.CopyFileName}">
				<MenuItem.Icon>
					<Image Classes="MenuItem_Icon" Source="{StaticResource Image/Icon.Copy.Outline}"/>
				</MenuItem.Icon>
			</MenuItem>
			<MenuItem Command="{Binding #root.CopyFilePath}" Header="{asXaml:StringResource SessionControl.CopyFilePath}">
				<MenuItem.Icon>
					<Image Classes="MenuItem_Icon" Source="{StaticResource Image/Icon.Copy.Outline}"/>
				</MenuItem.Icon>
			</MenuItem>
			<Separator/>
			<MenuItem Command="{Binding #root.ShowSourceFileInFileExplorer}" Header="{asXaml:StringResource SessionControl.ShowFileInExplorer}" IsEnabled="{x:Static c:Platform.IsOpeningFileManagerSupported}">
				<MenuItem.Icon>
					<Image Classes="MenuItem_Icon" Source="{StaticResource Image/Icon.FileManager.Outline}"/>
				</MenuItem.Icon>
			</MenuItem>
		</ContextMenu>

		<!-- Other actions -->
		<ContextMenu x:Key="otherActionsMenu" Placement="Bottom">
			<MenuItem Command="{Binding #root.((app:App)Application).ShowApplicationOptionsDialog}" Header="{asXaml:StringResource SessionControl.ApplicationOptions}">
				<MenuItem.Icon>
					<Image Classes="MenuItem_Icon" Source="{StaticResource Image/Icon.Settings.Outline}"/>
				</MenuItem.Icon>
			</MenuItem>
			<Separator/>
			<MenuItem Command="{Binding $parent[app:MainWindow].CreateMainWindow}" Header="{asXaml:StringResource Common.CreateWindow}" InputGesture="Ctrl+N">
				<MenuItem.Icon>
					<Image Classes="MenuItem_Icon" Source="{StaticResource Image/Icon.AddWindow}"/>
				</MenuItem.Icon>
			</MenuItem>
			<Separator/>
			<MenuItem Command="{Binding $parent[app:MainWindow].LayoutMainWindowsCommand}" CommandParameter="{x:Static asControls:MultiWindowLayout.Horizontal}" Header="{asXaml:StringResource MainWindow.LayoutMainWindows.Horizontal}">
				<MenuItem.Icon>
					<Image Classes="MenuItem_Icon" Source="{StaticResource Image/Icon.Layout.Horizontal}"/>
				</MenuItem.Icon>
			</MenuItem>
			<MenuItem Command="{Binding $parent[app:MainWindow].LayoutMainWindowsCommand}" CommandParameter="{x:Static asControls:MultiWindowLayout.Vertical}" Header="{asXaml:StringResource MainWindow.LayoutMainWindows.Vertical}">
				<MenuItem.Icon>
					<Image Classes="MenuItem_Icon" Source="{StaticResource Image/Icon.Layout.Vertical}"/>
				</MenuItem.Icon>
			</MenuItem>
			<MenuItem Command="{Binding $parent[app:MainWindow].LayoutMainWindowsCommand}" CommandParameter="{x:Static asControls:MultiWindowLayout.Tile}" Header="{asXaml:StringResource MainWindow.LayoutMainWindows.Tile}">
				<MenuItem.Icon>
					<Image Classes="MenuItem_Icon" Source="{StaticResource Image/Icon.Layout.Tile}"/>
				</MenuItem.Icon>
			</MenuItem>
			<Separator/>
			<MenuItem Name="toolsMenuItem" Header="{asXaml:StringResource SessionControl.Tools}" IsVisible="False">
				<MenuItem.Icon>
					<Image Classes="MenuItem_Icon" Source="{StaticResource Image/Icon.Tool.Outline}"/>
				</MenuItem.Icon>
				<MenuItem Name="editConfigMenuItem" Command="{Binding #root.((app:App)Application).ShowConfigurationEditor}" Header="Edit Configurations…" IsVisible="False">
					<MenuItem.Icon>
						<Image Classes="MenuItem_Icon" Source="{StaticResource Image/Icon.Tool.Outline}"/>
					</MenuItem.Icon>
				</MenuItem>
			</MenuItem>
			<Separator/>
			<MenuItem Command="{Binding #root.((app:App)Application).ShowApplicationInfoDialog}" Header="{asXaml:StringResource SessionControl.ApplicationInfo}">
				<MenuItem.Icon>
					<Image Classes="MenuItem_Icon" Source="{StaticResource Image/Icon.Information.Outline}"/>
				</MenuItem.Icon>
			</MenuItem>
		</ContextMenu>

		<!-- Save profile -->
		<ContextMenu x:Key="saveProfileMenu" Placement="Bottom">
			<MenuItem Command="{Binding SaveProfileCommand}" Header="{asXaml:StringResource SessionControl.SaveProfile}"/>
			<MenuItem Command="{Binding #root.SaveAsNewProfileCommand}" Header="{asXaml:StringResource SessionControl.SaveAsNewProfile}"/>
		</ContextMenu>

		<!-- Slider -->
		<sys:Double x:Key="SliderHorizontalHeight">0</sys:Double>
		<GridLength x:Key="SliderPostContentMargin">0</GridLength>
		<GridLength x:Key="SliderPreContentMargin">0</GridLength>
		
	</UserControl.Resources>

	<!-- Content -->
	<Grid RowDefinitions="Auto,*,Auto">

		<!-- Tool bar -->
		<Grid ColumnDefinitions="*,Auto">
			<Border Classes="Toolbar" BorderBrush="{DynamicResource Brush/Toolbar.Border}" BorderThickness="0,0,0,1">
				
				<!-- Image actions -->
				<asControls:ToolBarScrollViewer>
					<StackPanel Background="{x:Static Brushes.Transparent}" Orientation="Horizontal">

						<!-- Open file -->
						<Button Command="{Binding #root.OpenSourceFileCommand}" asControls:ToolbarElement.Role="Button" ToolTip.Tip="{asXaml:StringResource SessionControl.OpenSourceFile}">
							<Image asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.OpenFile.Outline}"/>
						</Button>

						<!-- Save image -->
						<Button Command="{Binding #root.SaveImageCommand}" asControls:ToolbarElement.Role="Button" ToolTip.Tip="{asXaml:StringResource SessionControl.SaveImage}">
							<Image asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.Save.Outline}"/>
						</Button>

						<!-- Refresh -->
						<Button Command="{Binding RenderImageCommand}" 
						        IsEnabled="{asXaml:AndBindings
						                       {Binding !IsFilteringRenderedImage},
						                       {Binding !IsPlayingFrames},
						                       {Binding !IsRenderingImage}
						                   }" 
						        asControls:ToolbarElement.Role="Button" 
						        ToolTip.Tip="{asXaml:StringResource Common.Refresh}">
							<Image asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.Refresh}"/>
						</Button>

						<!-- Separator -->
						<Separator asControls:ToolbarElement.Role="Separator"/>

						<!-- Fit to viewport -->
						<ToggleButton IsChecked="{Binding FitImageToViewport, Mode=TwoWay}" IsEnabled="{Binding IsSourceOpened}" asControls:ToolbarElement.Role="Button" ToolTip.Tip="{asXaml:StringResource SessionControl.FitRenderedImageToViewport}">
							<Panel>
								<Image asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.FitToScreen}" IsVisible="{Binding !#fitToViewportLightIcon.IsVisible}"/>
								<Image Name="fitToViewportLightIcon" asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.FitToScreen.Light}">
									<Image.IsVisible>
										<MultiBinding Converter="{x:Static BoolConverters.And}">
											<Binding Path="IsChecked" RelativeSource="{RelativeSource AncestorType={x:Type ToggleButton}}"/>
											<Binding Path="IsEnabled" RelativeSource="{RelativeSource AncestorType={x:Type ToggleButton}}"/>
										</MultiBinding>
									</Image.IsVisible>
								</Image>
							</Panel>
						</ToggleButton>
						
						<!-- Zoom to 100% -->
						<Button Command="{Binding #root.ZoomToOriginalImageSize}" IsEnabled="{Binding IsSourceOpened}" asControls:ToolbarElement.Role="Button" ToolTip.Tip="{asXaml:StringResource SessionControl.ZoomToOriginalImageSize}">
							<Image asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.OneToOne}"/>
						</Button>

						<!-- Zoom-out -->
						<RepeatButton Name="zoomOutButton" Command="{Binding ZoomOutCommand}" asControls:ToolbarElement.Role="Button" ToolTip.Tip="{asXaml:StringResource SessionControl.ZoomOut}">
							<Image asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.ZoomOut}"/>
						</RepeatButton>

						<!-- Zoom -->
						<Panel>
							<Panel.IsEnabled>
								<MultiBinding Converter="{x:Static aConverters:BoolConverters.Or}">
									<Binding Path="IsEffectivelyEnabled" ElementName="zoomOutButton"/>
									<Binding Path="IsEffectivelyEnabled" ElementName="zoomInButton"/>
								</MultiBinding>
							</Panel.IsEnabled>
							<TextBlock Opacity="0" asControls:ToolbarElement.Role="Label" Text="0000%"/>
							<TextBlock HorizontalAlignment="Center" asControls:ToolbarElement.Role="Label" Text="{Binding RequestedImageDisplayScale, Converter={x:Static asConverters:RatioToPercentageConverter.Default}}"/>
						</Panel>

						<!-- Zoom-in -->
						<RepeatButton Name="zoomInButton" Command="{Binding ZoomInCommand}" asControls:ToolbarElement.Role="Button" ToolTip.Tip="{asXaml:StringResource SessionControl.ZoomIn}">
							<Image asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.ZoomIn}"/>
						</RepeatButton>

						<!-- Separator -->
						<Separator asControls:ToolbarElement.Role="Separator"/>

						<!-- Rotate-left -->
						<Button Name="rotateLeftButton" Command="{Binding RotateLeftCommand}" asControls:ToolbarElement.Role="Button" ToolTip.Tip="{asXaml:StringResource SessionControl.RotateLeft}">
							<Image asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.RotateLeft}"/>
						</Button>

						<!-- Rotation -->
						<Panel>
							<Panel.IsEnabled>
								<MultiBinding Converter="{x:Static aConverters:BoolConverters.Or}">
									<Binding Path="IsEffectivelyEnabled" ElementName="rotateLeftButton"/>
									<Binding Path="IsEffectivelyEnabled" ElementName="rotateRightButton"/>
								</MultiBinding>
							</Panel.IsEnabled>
							<TextBlock Opacity="0" asControls:ToolbarElement.Role="Label" Text="0000"/>
							<TextBlock HorizontalAlignment="Center" asControls:ToolbarElement.Role="Label" Text="{Binding ImageDisplayRotation, Converter={x:Static appConverters:DegreesToStringConverter.Default}}"/>
						</Panel>

						<!-- Rotate-right -->
						<Button Name="rotateRightButton" Command="{Binding RotateRightCommand}" asControls:ToolbarElement.Role="Button" ToolTip.Tip="{asXaml:StringResource SessionControl.RotateRight}">
							<Image asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.RotateRight}"/>
						</Button>

						<!-- Separator -->
						<Separator asControls:ToolbarElement.Role="Separator"/>

						<!-- Flip-X -->
						<ToggleButton Name="flipXButton" IsChecked="{Binding IsImageFlippedX, Mode=TwoWay}" IsEnabled="{Binding IsSourceOpened}" asControls:ToolbarElement.Role="Button" ToolTip.Tip="{asXaml:StringResource SessionControl.FlipX}">
							<Panel>
								<Image asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.FlipX}" IsVisible="{Binding !$parent[ToggleButton].IsChecked}"/>
								<Image asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.FlipX.Light}" IsVisible="{Binding $parent[ToggleButton].IsChecked}"/>
							</Panel>
						</ToggleButton>

						<!-- Flip-Y -->
						<ToggleButton Name="flipYButton" IsChecked="{Binding IsImageFlippedY, Mode=TwoWay}" IsEnabled="{Binding IsSourceOpened}" asControls:ToolbarElement.Role="Button" ToolTip.Tip="{asXaml:StringResource SessionControl.FlipY}">
							<Panel>
								<Image asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.FlipY}" IsVisible="{Binding !$parent[ToggleButton].IsChecked}"/>
								<Image asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.FlipY.Light}" IsVisible="{Binding $parent[ToggleButton].IsChecked}"/>
							</Panel>
						</ToggleButton>

						<!-- Separator -->
						<Separator asControls:ToolbarElement.Role="Separator"/>

						<!-- Histograms -->
						<ToggleButton Name="histogramsButton" IsChecked="{Binding IsHistogramsVisible, Mode=TwoWay}" asControls:ToolbarElement.Role="Button" ToolTip.Tip="{asXaml:StringResource SessionControl.Histograms}">
							<Panel>
								<Image asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.Histogram}" IsVisible="{Binding !$parent[ToggleButton].IsChecked}"/>
								<Image asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.Histogram.Light}" IsVisible="{Binding $parent[ToggleButton].IsChecked}"/>
							</Panel>
						</ToggleButton>

						<!-- Separator -->
						<Separator asControls:ToolbarElement.Role="Separator"/>

						<!-- Frame navigation -->
						<StackPanel Orientation="Horizontal">

							<!-- First frame -->
							<Button Command="{Binding MoveToFirstFrameCommand}" asControls:ToolbarElement.Role="Button" ToolTip.Tip="{asXaml:StringResource SessionControl.MoveToFirstFrame}">
								<Image asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.FastBackward}"/>
							</Button>

							<!-- Previous frame -->
							<RepeatButton Command="{Binding MoveToPreviousFrameCommand}" asControls:ToolbarElement.Role="Button" ToolTip.Tip="{asXaml:StringResource SessionControl.MoveToPreviousFrame}">
								<Image asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.Backward}"/>
							</RepeatButton>

							<!-- Frame -->
							<Button Command="{Binding #root.MoveToSpecificFrame}" IsEnabled="{Binding HasMultipleFrames}" asControls:ToolbarElement.Role="Button" ToolTip.Tip="{asXaml:StringResource SessionControl.MoveToSpecificFrame}" Width="NaN">
								<Panel>
									<TextBlock Opacity="0" asControls:ToolbarElement.Role="Label" Text="000 / 000"/>
									<TextBlock HorizontalAlignment="Center" asControls:ToolbarElement.Role="Label">
										<TextBlock.Text>
											<MultiBinding StringFormat="{}{0} / {1}">
												<Binding Path="FrameNumber"/>
												<Binding Path="FrameCount"/>
											</MultiBinding>
										</TextBlock.Text>
									</TextBlock>
								</Panel>
							</Button>

							<!-- Next frame -->
							<RepeatButton Command="{Binding MoveToNextFrameCommand}" asControls:ToolbarElement.Role="Button" ToolTip.Tip="{asXaml:StringResource SessionControl.MoveToNextFrame}">
								<Image asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.Forward}"/>
							</RepeatButton>

							<!-- Last frame -->
							<Button Command="{Binding MoveToLastFrameCommand}" asControls:ToolbarElement.Role="Button" ToolTip.Tip="{asXaml:StringResource SessionControl.MoveToLastFrame}">
								<Image asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.FastForward}"/>
							</Button>

							<!-- Play/Pause frame sequence -->
							<Button Command="{Binding PlayFramesCommand}" asControls:ToolbarElement.Role="Button" ToolTip.Tip="{asXaml:StringResource SessionControl.PlayFrames}">
								<Panel>
									<Panel IsVisible="{Binding !IsPlayingFrames}">
										<Image asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.PlayMedia.Outline}" IsVisible="{Binding !$parent[Button].IsEffectivelyEnabled}"/>
										<Image asControls:ToolbarElement.Role="Icon" IsVisible="{Binding $parent[Button].IsEffectivelyEnabled}">
											<DrawingImage>
												<GeometryDrawing Brush="{DynamicResource Brush/Icon.OK}" Geometry="{DynamicResource Geometry/Icon.PlayMedia.Outline}"/>
											</DrawingImage>
										</Image>
									</Panel>
									<Image asControls:ToolbarElement.Role="Icon" IsVisible="{Binding IsPlayingFrames}">
										<DrawingImage>
											<GeometryDrawing Brush="{DynamicResource Brush/Icon.Warning}" Geometry="{DynamicResource Geometry/Icon.PauseMedia.Outline}"/>
										</DrawingImage>
									</Image>
								</Panel>
							</Button>

							<!-- Frame playback options -->
							<ToggleButton Name="framePlaybackOptionsButton" Command="{Binding #root.OpenFramePlaybackOptionsPopup}" IsEnabled="{Binding HasMultipleFrames}" asControls:ToolbarElement.Role="Button" ToolTip.Tip="{asXaml:StringResource SessionControl.FramePlaybackOptions}" Width="NaN">
								<Panel>
									<TextBlock Opacity="0" asControls:ToolbarElement.Role="Label" Text="{asXaml:StringResource SessionControl.FramePlaybackRate.Unlimited}"/>
									<abControls:FormattedTextBlock Arg1="{Binding FramePlaybackRate}" Format="{asXaml:StringResource SessionControl.FramePlaybackRate.Label}" HorizontalAlignment="Center" IsVisible="{Binding !IsFramePlaybackRateUnlimited}" asControls:ToolbarElement.Role="Label"/>
									<TextBlock HorizontalAlignment="Center" IsVisible="{Binding IsFramePlaybackRateUnlimited}" Text="{asXaml:StringResource SessionControl.FramePlaybackRate.Unlimited}" asControls:ToolbarElement.Role="Label"/>
									<Popup Name="framePlaybackOptionsPopup" Classes="SessionControl_FilterParamsPopup" Width="{StaticResource Double/SessionControl.FramePlaybackOptionsPopup.Width}">
										<Border Name="framePlaybackOptionsPopupBorder" Classes="SessionControl_FilterParamsPopup" Padding="{StaticResource Thickness/Dialog.ItemsGroup.Padding}">
											<StackPanel>

												<!-- Playback frame rate -->
												<asControls:DialogItem ItemSize="Small">
													<TextBlock Text="{asXaml:StringResource SessionControl.FramePlaybackRate}" asControls:DialogElement.TextRole="Label"/>
													<Slider asControls:DialogElement.IsDialogItemInput="True"
													        IsEnabled="{Binding !IsFramePlaybackRateUnlimited}" 
													        IsSnapToTickEnabled="False" 
													        Maximum="{Binding Source={x:Static appViewModels:Session.MaxFramePlaybackRate}}" 
													        Minimum="{Binding Source={x:Static appViewModels:Session.MinFramePlaybackRate}}" 
													        SmallChange="1"
													        TickPlacement="None"
													        Value="{Binding FramePlaybackRate, Mode=TwoWay}"
													        VerticalAlignment="Center"/>
												</asControls:DialogItem>
												<Separator asControls:DialogElement.SeparatorType="InnerItem"/>
												<UniformGrid Columns="5" ColumnSpacing="{StaticResource Double/Dialog.Separator.Width.Small}" IsEnabled="{Binding !IsFramePlaybackRateUnlimited}">
													<Button Command="{Binding #root.SetFramePlaybackRateCommand}" Content="{Binding $self.CommandParameter}" HorizontalAlignment="Stretch" asControls:DialogElement.IsDialogItemInput="True">
														<Button.CommandParameter>
															<sys:Int32>24</sys:Int32>
														</Button.CommandParameter>
													</Button>
													<Button Command="{Binding #root.SetFramePlaybackRateCommand}" Content="{Binding $self.CommandParameter}" HorizontalAlignment="Stretch" asControls:DialogElement.IsDialogItemInput="True">
														<Button.CommandParameter>
															<sys:Int32>25</sys:Int32>
														</Button.CommandParameter>
													</Button>
													<Button Command="{Binding #root.SetFramePlaybackRateCommand}" Content="{Binding $self.CommandParameter}" HorizontalAlignment="Stretch" asControls:DialogElement.IsDialogItemInput="True">
														<Button.CommandParameter>
															<sys:Int32>30</sys:Int32>
														</Button.CommandParameter>
													</Button>
													<Button Command="{Binding #root.SetFramePlaybackRateCommand}" Content="{Binding $self.CommandParameter}" HorizontalAlignment="Stretch" asControls:DialogElement.IsDialogItemInput="True">
														<Button.CommandParameter>
															<sys:Int32>50</sys:Int32>
														</Button.CommandParameter>
													</Button>
													<Button Command="{Binding #root.SetFramePlaybackRateCommand}" Content="{Binding $self.CommandParameter}" HorizontalAlignment="Stretch" asControls:DialogElement.IsDialogItemInput="True">
														<Button.CommandParameter>
															<sys:Int32>60</sys:Int32>
														</Button.CommandParameter>
													</Button>
												</UniformGrid>
												<Separator asControls:DialogElement.SeparatorType="Item"/>

												<!-- Play as fast as possible -->
												<asControls:DialogItem ItemSize="Small">
													<TextBlock Text="{asXaml:StringResource SessionControl.FramePlaybackRateUnlimited}" asControls:DialogElement.TextRole="Label"/>
													<ToggleSwitch IsChecked="{Binding IsFramePlaybackRateUnlimited, Mode=TwoWay}" asControls:DialogElement.IsDialogItemInput="True"/>
												</asControls:DialogItem>
												<Separator asControls:DialogElement.SeparatorType="Item"/>

												<!-- Loop playback -->
												<asControls:DialogItem ItemSize="Small">
													<TextBlock Text="{asXaml:StringResource SessionControl.LoopFramePlayback}" asControls:DialogElement.TextRole="Label"/>
													<ToggleSwitch IsChecked="{Binding IsFramePlaybackLooping, Mode=TwoWay}" asControls:DialogElement.IsDialogItemInput="True"/>
												</asControls:DialogItem>

											</StackPanel>
										</Border>
									</Popup>
								</Panel>
							</ToggleButton>

						</StackPanel>

					</StackPanel>
				</asControls:ToolBarScrollViewer>
			</Border>
			<Border Classes="Toolbar"
			        BorderBrush="{DynamicResource Brush/Toolbar.Border}"
			        BorderThickness="0,0,0,1"
			        Grid.Column="1"
			        IsVisible="{Binding #otherActionsButton.IsVisible}">

				<!-- Other actions -->
				<StackPanel Orientation="Horizontal">

					<!-- Other actions -->
					<ToggleButton Name="otherActionsButton" Command="{Binding #root.ShowOtherActions}" IsVisible="{x:Static c:Platform.IsNotMacOS}" asControls:ToolbarElement.Role="Button" ToolTip.Tip="{asXaml:StringResource SessionControl.OtherActions}">
						<Panel>
							<Image asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.More}" IsVisible="{Binding !$parent[ToggleButton].IsChecked}"/>
							<Image asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.More.Light}" IsVisible="{Binding $parent[ToggleButton].IsChecked}"/>
						</Panel>
					</ToggleButton>

				</StackPanel>
				
			</Border>
		</Grid>
		<ProgressBar Background="{x:Null}" CornerRadius="0" IsIndeterminate="True" IsVisible="{Binding #root.CanShowProgressBar}" MaxHeight="{StaticResource Double/SessionControl.ImageProgressBar.Height}" MinHeight="{StaticResource Double/SessionControl.ImageProgressBar.Height}" VerticalAlignment="Bottom"/>

		<!-- Viewer -->
		<Grid Name="workingAreaGrid" Grid.Row="1">

			<!-- Columns -->
			<Grid.ColumnDefinitions>
				<ColumnDefinition MaxWidth="{x:Static appViewModels:Session.MaxHistogramsPanelSize}" Width="0"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition MaxWidth="{x:Static appViewModels:Session.MaxRenderingParametersPanelSize}" Width="0"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<!-- Histograms -->
			<Border Background="{DynamicResource Brush/WorkingArea.Background}" Grid.ColumnSpan="2"/>
			<Border Background="{DynamicResource Brush/WorkingArea.Panel.Background}"
			        IsVisible="{Binding IsHistogramsVisible}">
				<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
					<StackPanel Margin="{StaticResource Thickness/SessionControl.HistogramsPanel.Padding}">

						<!-- Styles -->
						<StackPanel.Styles>
							<Style Selector="appControls|BitmapHistogramsView">
								<Setter Property="Height" Value="{StaticResource Double/SessionControl.Histogram.Height}"/>
								<Setter Property="HorizontalAlignment" Value="Stretch"/>
							</Style>
						</StackPanel.Styles>

						<!-- Luminance -->
						<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" Text="{asXaml:StringResource SessionControl.Histogram.Luminance}"/>
						<appControls:BitmapHistogramsView DataContext="{Binding Histograms}" IsLuminanceHistogramVisible="True" IsMeanMarkerVisible="{Binding #root.((appViewModels:Session)DataContext).IsHistogramMeanMarkerVisible, FallbackValue=True}"/>
						<Border Background="{DynamicResource Brush/BitmapHistogramsView.LuminanceHistogram.Background}" Height="{StaticResource Double/SessionControl.Histogram.RangeBar.Height}" Margin="{StaticResource Thickness/SessionControl.Histogram.RangeBar.Margin}"/>
						<Separator asControls:DialogElement.SeparatorType="Default"/>

						<!-- Red -->
						<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" Text="{asXaml:StringResource SessionControl.Histogram.Red}"/>
						<appControls:BitmapHistogramsView DataContext="{Binding Histograms}" IsRedHistogramVisible="True" IsMeanMarkerVisible="{Binding #root.((appViewModels:Session)DataContext).IsHistogramMeanMarkerVisible, FallbackValue=True}"/>
						<Border Background="{DynamicResource Brush/BitmapHistogramsView.RedHistogram.Background}" Height="{StaticResource Double/SessionControl.Histogram.RangeBar.Height}" Margin="{StaticResource Thickness/SessionControl.Histogram.RangeBar.Margin}"/>
						<Separator asControls:DialogElement.SeparatorType="Default"/>

						<!-- Green -->
						<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" Text="{asXaml:StringResource SessionControl.Histogram.Green}"/>
						<appControls:BitmapHistogramsView DataContext="{Binding Histograms}" IsGreenHistogramVisible="True" IsMeanMarkerVisible="{Binding #root.((appViewModels:Session)DataContext).IsHistogramMeanMarkerVisible, FallbackValue=True}"/>
						<Border Background="{DynamicResource Brush/BitmapHistogramsView.GreenHistogram.Background}" Height="{StaticResource Double/SessionControl.Histogram.RangeBar.Height}" Margin="{StaticResource Thickness/SessionControl.Histogram.RangeBar.Margin}"/>
						<Separator asControls:DialogElement.SeparatorType="Default"/>

						<!-- Blue -->
						<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" Text="{asXaml:StringResource SessionControl.Histogram.Blue}"/>
						<appControls:BitmapHistogramsView DataContext="{Binding Histograms}" IsBlueHistogramVisible="True" IsMeanMarkerVisible="{Binding #root.((appViewModels:Session)DataContext).IsHistogramMeanMarkerVisible, FallbackValue=True}"/>
						<Border Background="{DynamicResource Brush/BitmapHistogramsView.BlueHistogram.Background}" Height="{StaticResource Double/SessionControl.Histogram.RangeBar.Height}" Margin="{StaticResource Thickness/SessionControl.Histogram.RangeBar.Margin}"/>
						<Separator asControls:DialogElement.SeparatorType="Default"/>

						<!-- Markers -->
						<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" Text="{asXaml:StringResource SessionControl.Histogram.Markers}"/>
						<Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" HorizontalAlignment="Stretch" RowDefinitions="Auto">
							
							<!-- Styles -->
							<Grid.Styles>
								<Style Selector="Line">
									<Setter Property="Stretch" Value="Fill"/>
									<Setter Property="VerticalAlignment" Value="Center"/>
								</Style>
							</Grid.Styles>
							
							<!-- Mean -->
							<CheckBox Classes="Dialog_CheckBox" IsChecked="{Binding IsHistogramMeanMarkerVisible, Mode=TwoWay}">
								<TextBlock Text="{asXaml:StringResource SessionControl.Histogram.Marker.Mean}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
							</CheckBox>
							<Line Grid.Column="1" EndPoint="24,0" StartPoint="0,0" Stroke="{DynamicResource Brush/BitmapHistogramsView.MeanOfLuminance}" StrokeDashArray="4,1" StrokeThickness="1"/>
							
						</Grid>
						
					</StackPanel>
				</ScrollViewer>
			</Border>

			<!-- Splitter -->
			<GridSplitter Background="{x:Static Brushes.Transparent}"
			              BorderBrush="{DynamicResource Brush/WorkingArea.Panel.Border}"
			              BorderThickness="1,0,0,0"
			              Classes="GridSplitter_Vertical"
			              DragCompleted="OnHistogramsPanelSplitterDragCompleted"
			              DragStarted="OnHistogramsPanelSplitterDragStarted"
			              Grid.Column="1"
			              IsVisible="{Binding IsHistogramsVisible}"
			              ZIndex="1"/>

			<!-- Image viewer -->
			<Grid Name="imageViewerGrid" Background="{DynamicResource Brush/WorkingArea.Background}"
			      DragDrop.AllowDrop="True"
			      Grid.Column="1"
			      RowDefinitions="*,Auto">

				<!-- Image -->
				<ScrollViewer x:Name="imageScrollViewer" 
				              AllowAutoHide="{Binding #root.HideImageViewerScrollBarsAutomatically}"
				              Background="{x:Static Brushes.Transparent}" 
				              HorizontalScrollBarVisibility="Disabled"
				              IsScrollInertiaEnabled="False"
				              Pinch="OnImagePinch" 
				              PinchEnded="OnImagePinchEnded" 
				              PointerTouchPadGestureMagnify="OnImagePointerTouchPadGestureMagnify"
				              PointerPressed="OnImageScrollViewerPointerPressed"
				              VerticalScrollBarVisibility="Disabled">
					<ScrollViewer.GestureRecognizers>
						<PinchGestureRecognizer/>
					</ScrollViewer.GestureRecognizers>
					<Panel ClipToBounds="False" Margin="{StaticResource Thickness/SessionControl.ImageViewer.Padding}" UseLayoutRounding="True">
						<Panel Name="imageContainerBorder" ClipToBounds="False" HorizontalAlignment="Center" VerticalAlignment="Center">
							<Border Margin="0.5"> <!-- [Workaround] Prevent background being larger than image on any edge -->
								<Border.Background>
									<ImageBrush DestinationRect="0,0,20,20" Source="/Resources/RenderedImageBackground.png" TileMode="Tile"/>
								</Border.Background>
								<Border Background="{DynamicResource Brush/SessionControl.ImageViewer.Placeholder.Mask}" IsVisible="{Binding !HasRenderedImage}"/>
							</Border>
							<LayoutTransformControl ClipToBounds="False">
								<Panel ClipToBounds="False">
									<Image x:Name="image" DoubleTapped="OnImageDoubleTapped" Height="{Binding ImageDisplaySize.Height}" HorizontalAlignment="Center" PointerExited="OnImagePointerLeave" PointerMoved="OnImagePointerMoved" PointerPressed="OnImagePointerPressed" PointerReleased="OnImagePointerReleased" Source="{Binding #root.EffectiveRenderedImage}" Stretch="Fill" VerticalAlignment="Center" Width="{Binding ImageDisplaySize.Width}"/>
									<Border BorderBrush="{DynamicResource Brush/WorkingArea.Background}" 
									        BorderThickness="1" 
									        CornerRadius="2" 
									        Height="{Binding #root.SelectedImageDisplayPixelBounds.Height}" 
									        HorizontalAlignment="Left" 
									        IsHitTestVisible="False" 
									        Margin="0,0,-1,-1"
									        VerticalAlignment="Top" 
									        Width="{Binding #root.SelectedImageDisplayPixelBounds.Width}">
										<Border.IsVisible>
											<MultiBinding Converter="{x:Static BoolConverters.And}">
												<Binding Path="HasRenderedImage"/>
												<Binding Path="IsPointerOverImage" ElementName="root"/>
												<MultiBinding Converter="{x:Static BoolConverters.Or}">
													<Binding Path="!IsImageViewerScrollable" ElementName="root"/>
													<Binding Path="!IsPointerPressedOnImage" ElementName="root"/>
												</MultiBinding>
											</MultiBinding>
										</Border.IsVisible>
										<Border.RenderTransform>
											<TranslateTransform X="{Binding #root.SelectedImageDisplayPixelBounds.X}" Y="{Binding #root.SelectedImageDisplayPixelBounds.Y}"/>
										</Border.RenderTransform>
										<Border BorderBrush="{DynamicResource TextControlForeground}" BorderThickness="1">
											<Border BorderBrush="{DynamicResource Brush/WorkingArea.Background}" BorderThickness="1"/>
										</Border>
									</Border>
								</Panel>
								<LayoutTransformControl.LayoutTransform>
									<TransformGroup>
										<ScaleTransform ScaleX="{Binding IsImageFlippedX, Converter={x:Static appConverters:BoolToScaleConverter.Default}}" ScaleY="{Binding IsImageFlippedY, Converter={x:Static appConverters:BoolToScaleConverter.Default}}"/>
										<RotateTransform Angle="{Binding ImageDisplayRotation}"/>
									</TransformGroup>
								</LayoutTransformControl.LayoutTransform>
							</LayoutTransformControl>
						</Panel>
						<Canvas ClipToBounds="False" Height="{Binding #imageContainerBorder.Bounds.Height}" HorizontalAlignment="Center" IsVisible="{Binding HasRenderedImage}" VerticalAlignment="Center" Width="{Binding #imageContainerBorder.Bounds.Width}"/>
					</Panel>
				</ScrollViewer>

				<!-- Hint -->
				<Viewbox IsHitTestVisible="False" Margin="{StaticResource Thickness/SessionControl.ImageViewer.Hint.Margin}" Stretch="Uniform" StretchDirection="DownOnly">
					<Panel Opacity="{StaticResource Double/SessionControl.Hint.Opacity}">

						<!-- Drag-drop hint -->
						<Border IsVisible="{Binding !IsOpeningSource}">
							<StackPanel HorizontalAlignment="Center" IsVisible="{Binding !IsSourceOpened}" Orientation="Horizontal" VerticalAlignment="Center">
								<TextBlock Classes="SessionControl_ImageViewer_Hint_TextBlock" Text="{asXaml:StringResource SessionControl.DragDropHint.Section1}"/>
								<Image Classes="SessionControl_ImageViewer_Hint_Icon" Source="{StaticResource Image/Icon.OpenFile.Outline}"/>
								<TextBlock Classes="SessionControl_ImageViewer_Hint_TextBlock" Text="{asXaml:StringResource SessionControl.DragDropHint.Section2}"/>
							</StackPanel>
						</Border>

						<!-- Opening file hint -->
						<StackPanel HorizontalAlignment="Center" IsVisible="{Binding IsOpeningSource}" Orientation="Horizontal" VerticalAlignment="Center">
							<Image Classes="SessionControl_ImageViewer_Hint_Icon" Source="{StaticResource Image/Icon.OpenFile.Outline}"/>
							<TextBlock Classes="SessionControl_ImageViewer_Hint_TextBlock" Text="{asXaml:StringResource SessionControl.OpeningSource}"/>
						</StackPanel>

						<!-- Rendering error -->
						<StackPanel HorizontalAlignment="Center" IsVisible="{asXaml:AndBindings {Binding HasRenderingError}, {Binding !HasRenderedImage}}" Orientation="Horizontal" VerticalAlignment="Center">
							<Image Classes="SessionControl_ImageViewer_Hint_Icon" Source="{StaticResource Image/Icon.Error.Outline}"/>
							<TextBlock Classes="SessionControl_ImageViewer_Hint_TextBlock" Text="{asXaml:StringResource SessionControl.RenderingErrorOccurred}"/>
						</StackPanel>
						
						<!-- Other error -->
						<StackPanel HorizontalAlignment="Center" IsVisible="{asXaml:AndBindings {Binding InsufficientMemoryForRenderedImage}, {Binding !HasRenderedImage}}" Orientation="Horizontal" VerticalAlignment="Center">
							<Image Classes="SessionControl_ImageViewer_Hint_Icon" Source="{StaticResource Image/Icon.Warning.Outline}"/>
							<TextBlock Classes="SessionControl_ImageViewer_Hint_TextBlock" Text="{asXaml:StringResource SessionControl.NoImageRendered}"/>
						</StackPanel>

					</Panel>
				</Viewbox>

				<!-- Pixel information -->
				<Border Classes="StatusBar" 
				        Background="{DynamicResource Brush/WorkingArea.Panel.Background}" 
				        BorderBrush="{DynamicResource Brush/WorkingArea.Panel.Border}"
				        BorderThickness="0,1,0,0"
				        Grid.Row="1" 
				        IsVisible="{asXaml:AndBindings {Binding IsSourceOpened}, {Binding !IsOpeningSource}}">
					<Border.Styles>
						<Style Selector="TextBlock">
							<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
							<Setter Property="Margin" Value="{StaticResource Thickness/StatusBar.Item.Margin}"/>
							<Setter Property="VerticalAlignment" Value="Center"/>
						</Style>
					</Border.Styles>
					<Panel>
						<TextBlock Opacity="0" Text="{asXaml:StringResource SessionControl.SelectedPixel.None}"/>
						<TextBlock IsVisible="{asXaml:AndBindings {Binding HasRenderedImage}, {Binding !HasSelectedRenderedImagePixel}}" Text="{asXaml:StringResource SessionControl.SelectedPixel.None}" TextWrapping="Wrap"/>
						<TextBlock IsVisible="{Binding !HasRenderedImage}" Text="{asXaml:StringResource SessionControl.SelectedPixel.NoRenderedImage}" TextWrapping="Wrap"/>
						<WrapPanel Opacity="{Binding HasSelectedRenderedImagePixel, Converter={x:Static abConverters:BooleanToValueConverters.BooleanToOpacity}}" Orientation="Horizontal" TextElement.FontFamily="{x:Static asMedia:BuiltInFonts.RobotoMono}">
							
							<!-- Position -->
							<StackPanel Orientation="Horizontal">
								<Image asControls:StatusBarElement.Role="Icon" Source="{StaticResource Image/Icon.Coordinates}"/>
								<LayoutTransformControl>
									<LayoutTransformControl.LayoutTransform>
										<ScaleTransform ScaleX="{StaticResource Double/SessionControl.PixelInformation.ScaleX}"/>
									</LayoutTransformControl.LayoutTransform>
									<Panel>
										<abControls:FormattedTextBlock Arg1="{Binding ImageWidth}" Arg2="{Binding ImageHeight}" Format="({0}, {1})" Opacity="0" asControls:StatusBarElement.Role="Label"/>
										<abControls:FormattedTextBlock Arg1="{Binding SelectedRenderedImagePixelPositionX}" Arg2="{Binding SelectedRenderedImagePixelPositionY}" Format="({0}, {1})" asControls:StatusBarElement.Role="Label"/>
									</Panel>
								</LayoutTransformControl>
								<Separator asControls:StatusBarElement.Role="Separator"/>
							</StackPanel>

							<!-- Color -->
							<StackPanel Orientation="Horizontal">
								<Border BorderBrush="{DynamicResource SystemControlForegroundBaseHighBrush}" BorderThickness="1" Height="{StaticResource Double/StatusBar.Icon.Size}" Width="{StaticResource Double/StatusBar.Icon.Size}">
									<Border.Background>
										<SolidColorBrush Color="{Binding SelectedRenderedImagePixelColor.Color}"/>
									</Border.Background>
								</Border>
							</StackPanel>

							<!-- ARGB Color -->
							<StackPanel IsVisible="{Binding #root.ShowSelectedRenderedImagePixelArgbColor}" Orientation="Horizontal">
								<Separator asControls:StatusBarElement.Role="Separator"/>
								<LayoutTransformControl>
									<LayoutTransformControl.LayoutTransform>
										<ScaleTransform ScaleX="{StaticResource Double/SessionControl.PixelInformation.ScaleX}"/>
									</LayoutTransformControl.LayoutTransform>
									<TextBlock Text="{Binding #root.SelectedImageDisplayPixelArgbString}" asControls:StatusBarElement.Role="Label"/>
								</LayoutTransformControl>
							</StackPanel>

							<!-- CIELAB Color -->
							<StackPanel IsVisible="{Binding #root.ShowSelectedRenderedImagePixelLabColor}" Orientation="Horizontal">
								<Separator asControls:StatusBarElement.Role="Separator"/>
								<LayoutTransformControl>
									<LayoutTransformControl.LayoutTransform>
										<ScaleTransform ScaleX="{StaticResource Double/SessionControl.PixelInformation.ScaleX}"/>
									</LayoutTransformControl.LayoutTransform>
									<Panel>
										<TextBlock Opacity="0" Text="L*a*b*(100.00, -99.99, -99.99)"/>
										<abControls:FormattedTextBlock Arg1="{Binding SelectedRenderedImagePixelLabColor.Item1}" Arg2="{Binding SelectedRenderedImagePixelLabColor.Item2}" Arg3="{Binding SelectedRenderedImagePixelLabColor.Item3}" Format="L*a*b*({0:00.00}, {1:+0.00;-0.00;0.00}, {2:+0.00;-0.00;0.00})"/>
									</Panel>
								</LayoutTransformControl>
							</StackPanel>

							<!-- XYZ Color -->
							<StackPanel IsVisible="{Binding #root.ShowSelectedRenderedImagePixelXyzColor}" Orientation="Horizontal">
								<Separator asControls:StatusBarElement.Role="Separator"/>
								<LayoutTransformControl>
									<LayoutTransformControl.LayoutTransform>
										<ScaleTransform ScaleX="{StaticResource Double/SessionControl.PixelInformation.ScaleX}"/>
									</LayoutTransformControl.LayoutTransform>
									<Panel>
										<TextBlock Opacity="0" Text="XYZ(100.00, 100.00, 100.00)"/>
										<abControls:FormattedTextBlock Arg1="{Binding SelectedRenderedImagePixelXyzColor.Item1}" Arg2="{Binding SelectedRenderedImagePixelXyzColor.Item2}" Arg3="{Binding SelectedRenderedImagePixelXyzColor.Item3}" Format="XYZ({0:F2}, {1:F2}, {2:F2})"/>
									</Panel>
								</LayoutTransformControl>
							</StackPanel>
							
						</WrapPanel>
					</Panel>
				</Border>
				
			</Grid>
			
			<!-- Shadow -->
			<Border BoxShadow="{DynamicResource BoxShadows/Shadow.Inner.Light}"
			        Grid.Column="1"
			        Grid.ColumnSpan="{Binding #imageViewerGrid.(Grid.ColumnSpan)}"
			        IsHitTestVisible="false"
			        Margin="{Binding #root.ImageViewerShadowsMargin}"/>

			<!-- Side panel -->
			<Panel Name="sidePanelContainer" 
			       Background="{DynamicResource Brush/WorkingArea.Panel.Background}" 
			       Grid.Column="4" 
			       IsVisible="{asXaml:OrBindings 
			                      {Binding IsFilterPanelVisible}, 
			                      {Binding IsRenderingParametersPanelVisible}
			                  }">

				<!-- Rendering parameters panel -->
				<DockPanel IsEnabled="{Binding IsSourceOpened}" IsVisible="{Binding IsRenderingParametersPanelVisible}">

					<!-- Resources -->
					<DockPanel.Resources>
						<StaticResourceExtension x:Key="Double/Dialog.Separator.Height.Small" ResourceKey="Double/SessionControl.SidePanel.Separator.Height.Small"/>
					</DockPanel.Resources>

					<!-- Styles -->
					<DockPanel.Styles>
						<Style Selector="TextBlock">
							<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
						</Style>
					</DockPanel.Styles>

					<!-- Profile -->
					<Border Classes="SessionControl_SidePanel_ProfilePanel" DockPanel.Dock="Top">
						<ComboBox Classes="Dialog_ComboBox" ItemsSource="{Binding Profiles}" ItemsPanel="{StaticResource ItemsPanelTemplate/StackPanel}" SelectedItem="{Binding Profile, Mode=TwoWay}" ToolTip.Tip="{asXaml:StringResource SessionControl.Profile}">
							<ComboBox.ItemTemplate>
								<DataTemplate>
									<Grid ColumnDefinitions="*,Auto">
										<TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
										<Border Background="{DynamicResource Brush/SessionControl.ProfileTypeLabel.Background.FileFormat}" 
										        BorderBrush="{DynamicResource Brush/SessionControl.ImageFormatCategoryLabel.Border}" 
										        BorderThickness="{StaticResource Thickness/SessionControl.ImageFormatCategoryLabel.Border}" 
										        CornerRadius="{StaticResource CornerRadius/SessionControl.ImageFormatCategoryLabel}" 
										        Grid.Column="1" 
										        IsVisible="{Binding IsFileFormat}" 
										        Margin="{StaticResource Thickness/SessionControl.ImageFormatCategoryLabel.Margin}" 
										        Padding="{StaticResource Thickness/SessionControl.ImageFormatCategoryLabel.Padding}" 
										        VerticalAlignment="Center">
											<TextBlock FontSize="{StaticResource Double/SessionControl.ImageFormatCategoryLabel.FontSize}" FontWeight="Bold" Foreground="{DynamicResource Brush/SessionControl.ImageFormatCategoryLabel.Foreground}" Text="{asXaml:StringResource SessionControl.ProfileTypeLabel.FileFormat}"/>
										</Border>
									</Grid>
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
					</Border>

					<!-- Profile actions -->
					<Border Classes="SessionControl_SidePanel_ActionsPanel" DockPanel.Dock="Bottom">
						<Grid ColumnDefinitions="Auto,*,Auto,Auto">

							<!-- Apply profile -->
							<Button Command="{Binding ApplyProfileCommand}" asControls:ToolbarElement.Role="Button" ToolTip.Placement="Top" ToolTip.Tip="{asXaml:StringResource SessionControl.ApplyProfile}" ToolTip.VerticalOffset="0">
								<Image asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.Reset}"/>
							</Button>

							<!-- Save profile -->
							<asControls:SplitButton Command="{Binding #root.SaveOrSaveAsNewProfileCommand}" DropDownMenu="{StaticResource saveProfileMenu}" Grid.Column="2" asControls:ToolbarElement.Role="Button" ToolTip.Placement="Top" ToolTip.Tip="{asXaml:StringResource Common.Save}" ToolTip.VerticalOffset="0">
								<Image asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.Save.Outline}"/>
							</asControls:SplitButton>

							<!-- Delete profile -->
							<Button Command="{Binding DeleteProfileCommand}" Grid.Column="3" asControls:ToolbarElement.Role="Button" ToolTip.Placement="Top" ToolTip.Tip="{asXaml:StringResource SessionControl.DeleteProfile}" ToolTip.VerticalOffset="0">
								<Image asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.Delete.Outline}"/>
							</Button>

						</Grid>
					</Border>

					<!-- Parameters -->
					<ScrollViewer Name="renderingParamsPanelScrollViewer" HorizontalScrollBarVisibility="Disabled">
						<StackPanel Margin="{StaticResource Thickness/SessionControl.SidePanel.Padding}">

							<!-- Format -->
							<Expander Name="formatParamsExpander" Classes="SessionControl_SidePanel_Expander">
								<Expander.Header>
									<Grid ColumnDefinitions="Auto,*">
										<TextBlock Text="{asXaml:StringResource SessionControl.RenderingParametersPanel.Format}" VerticalAlignment="Center"/>
										<TextBlock Classes="SessionControl_SidePanel_Expander_Summary" Grid.Column="1" IsVisible="{Binding !$parent[Expander].IsExpanded}" Text="{Binding ImageRenderer.Format.DisplayName}"/>
									</Grid>
								</Expander.Header>
								<StackPanel>
									<!-- Data offset -->
									<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" Text="{asXaml:StringResource SessionControl.DataOffset}"/>
									<abControls:IntegerTextBox Classes="Dialog_TextBlock" IsNullValueAllowed="False" Minimum="0" Value="{Binding DataOffset, Mode=TwoWay}">
										<abControls:IntegerTextBox.InnerRightContent>
											<TextBlock Classes="SessionControl_SidePanel_Unit" Text="{asXaml:StringResource Common.Bytes}"/>
										</abControls:IntegerTextBox.InnerRightContent>
									</abControls:IntegerTextBox>
									<Separator asControls:DialogElement.SeparatorType="Small"/>

									<!-- Frame padding bytes -->
									<StackPanel IsVisible="{Binding HasMultipleFrames}">
										<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" Text="{asXaml:StringResource SessionControl.FramePaddingSize}"/>
										<abControls:IntegerTextBox Classes="Dialog_TextBlock" Minimum="0" Value="{Binding FramePaddingSize, Mode=TwoWay}">
											<abControls:IntegerTextBox.InnerRightContent>
												<TextBlock Classes="SessionControl_SidePanel_Unit" Text="{asXaml:StringResource Common.Bytes}"/>
											</abControls:IntegerTextBox.InnerRightContent>
										</abControls:IntegerTextBox>
										<Separator asControls:DialogElement.SeparatorType="Small"/>
									</StackPanel>

									<!-- Image renderer -->
									<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" Text="{asXaml:StringResource SessionControl.ImageRenderer}"/>
									<ComboBox Name="imageRendererComboBox" Classes="Dialog_ComboBox" ItemsSource="{x:Static appImageRenderers:ImageRenderers.All}" ItemsPanel="{StaticResource ItemsPanelTemplate/StackPanel}" SelectedItem="{Binding ImageRenderer, Mode=TwoWay}">
										<ComboBox.ItemTemplate>
											<DataTemplate>
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Text="{Binding Format.DisplayName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
													<Border Background="{Binding Format.Category, Converter={x:Static appConverters:ImageFormatCategoryToBrushConverter.Background}}" 
													        BorderBrush="{Binding Format.Category, Converter={x:Static appConverters:ImageFormatCategoryToBrushConverter.Border}}" 
													        BorderThickness="{StaticResource Thickness/SessionControl.ImageFormatCategoryLabel.Border}" 
													        CornerRadius="{StaticResource CornerRadius/SessionControl.ImageFormatCategoryLabel}" 
													        Grid.Column="1" Margin="{StaticResource Thickness/SessionControl.ImageFormatCategoryLabel.Margin}" 
													        Opacity="{Binding $self.IsEffectivelyEnabled, Converter={x:Static appControls:SessionControl.BooleanToImageFormatCategoryLabelOpacityConverter}}"
													        Padding="{StaticResource Thickness/SessionControl.ImageFormatCategoryLabel.Padding}" 
													        VerticalAlignment="Center">
														<TextBlock FontSize="{StaticResource Double/SessionControl.ImageFormatCategoryLabel.FontSize}" FontWeight="Bold" Foreground="{DynamicResource Brush/SessionControl.ImageFormatCategoryLabel.Foreground}" Text="{Binding Format.Category, Converter={x:Static appConverters:EnumConverters.ImageFormatCategory}}"/>
													</Border>
												</Grid>
											</DataTemplate>
										</ComboBox.ItemTemplate>
									</ComboBox>
									<Separator asControls:DialogElement.SeparatorType="Small"/>

									<!-- Byte ordering -->
									<StackPanel IsVisible="{Binding HasMultipleByteOrderings}">
										<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" Text="{asXaml:StringResource SessionControl.ByteOrdering}"/>
										<asControls:EnumComboBox Classes="Dialog_ComboBox" EnumType="{x:Type app:ByteOrdering}" SelectedItem="{Binding ByteOrdering, Mode=TwoWay}"/>
										<Separator asControls:DialogElement.SeparatorType="Small"/>
									</StackPanel>

									<!-- Bayer Pattern -->
									<StackPanel IsVisible="{Binding IsBayerPatternSupported}">
										<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" Text="{asXaml:StringResource SessionControl.BayerPattern}"/>
										<asControls:EnumComboBox Classes="Dialog_ComboBox" EnumType="{x:Type appMedia:BayerPattern}" SelectedItem="{Binding BayerPattern, Mode=TwoWay}"/>
										<Separator asControls:DialogElement.SeparatorType="Small"/>
									</StackPanel>

									<!-- YUV to RGB converter -->
									<StackPanel IsVisible="{Binding IsYuvToBgraConverterSupported}">
										<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" Text="{asXaml:StringResource SessionControl.YuvToBgraConverter}"/>
										<ComboBox Name="yuvToBgraConverterComboBox" Classes="Dialog_ComboBox" ItemsSource="{x:Static appMedia:YuvToBgraConverter.All}" ItemsPanel="{StaticResource ItemsPanelTemplate/StackPanel}" SelectedItem="{Binding YuvToBgraConverter, Mode=TwoWay}">
											<ComboBox.ItemTemplate>
												<DataTemplate>
													<TextBlock Text="{Binding Converter={x:Static appConverters:YuvToBgraConverterToStringConverter.Default}}"/>
												</DataTemplate>
											</ComboBox.ItemTemplate>
										</ComboBox>
										<Separator asControls:DialogElement.SeparatorType="Small"/>
									</StackPanel>

									<!-- Demosaicing -->
									<Grid Classes="SessionControl_SidePanel_SwitchItem" ColumnDefinitions="*,Auto" IsVisible="{Binding IsDemosaicingSupported}">
										<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" Text="{asXaml:StringResource SessionControl.Demosaicing}" VerticalAlignment="Center"/>
										<ToggleSwitch Grid.Column="1" IsChecked="{Binding Demosaicing, Mode=TwoWay}" asControls:DialogElement.IsDialogItemInput="True"/>
									</Grid>
									<Separator asControls:DialogElement.SeparatorType="Small" IsVisible="{Binding IsDemosaicingSupported}"/>
								</StackPanel>
							</Expander>

							<!-- Dimensions -->
							<Expander Name="dimensionsParamsExpander" Classes="SessionControl_SidePanel_Expander">
								<Expander.Header>
									<Grid ColumnDefinitions="Auto,*">
										<TextBlock Text="{asXaml:StringResource SessionControl.RenderingParametersPanel.Dimensions}" VerticalAlignment="Center"/>
										<TextBlock Classes="SessionControl_SidePanel_Expander_Summary" Grid.Column="1" IsVisible="{Binding !$parent[Expander].IsExpanded}">
											<TextBlock.Text>
												<MultiBinding StringFormat="{}{0} × {1}">
													<Binding Path="ImageWidth"/>
													<Binding Path="ImageHeight"/>
												</MultiBinding>
											</TextBlock.Text>
										</TextBlock>
									</Grid>
								</Expander.Header>
								<StackPanel>
									<!-- Dimensions -->
									<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" Text="{asXaml:StringResource SessionControl.ImageDimensions}"/>
									<Grid ColumnDefinitions="*,Auto,*">
										<Panel>
											<abControls:IntegerTextBox Name="imageWidthTextBox" Classes="Dialog_TextBox" IsNullValueAllowed="False" Maximum="65535" Minimum="1" Value="{Binding ImageWidth, Mode=TwoWay}">
												<abControls:IntegerTextBox.InnerRightContent>
													<Panel Classes="TextBox_InPlaceActions">
														<ToggleButton Name="alignImageWidthButton" Classes="TextBox_InPlaceAction" Command="{Binding #root.ShowAlignToIntegerMenu}" CommandParameter="{Binding $self}" HorizontalAlignment="Right" Tag="{Binding #imageWidthTextBox}" ToolTip.Tip="{asXaml:StringResource SessionControl.AlignToInteger}" VerticalAlignment="Center">
															<Panel>
																<Image Classes="Icon" IsVisible="{Binding !$parent[ToggleButton].IsChecked}" Source="{StaticResource Image/Icon.Alignment.Horizontal}"/>
																<Image Classes="Icon" IsVisible="{Binding $parent[ToggleButton].IsChecked}" Source="{StaticResource Image/Icon.Alignment.Horizontal.Light}"/>
															</Panel>
														</ToggleButton>
													</Panel>
												</abControls:IntegerTextBox.InnerRightContent>
											</abControls:IntegerTextBox>
										</Panel>
										<TextBlock Grid.Column="1" Margin="3,0,3,0" Text="×" VerticalAlignment="Center"/>
										<Panel Grid.Column="2">
											<abControls:IntegerTextBox Name="imageHeightTextBox" Classes="Dialog_TextBox" IsNullValueAllowed="False" Maximum="65535" Minimum="1" Value="{Binding ImageHeight, Mode=TwoWay}">
												<abControls:IntegerTextBox.InnerRightContent>
													<Panel Classes="TextBox_InPlaceActions">
														<ToggleButton Name="alignImageHeightButton" Classes="TextBox_InPlaceAction" Command="{Binding #root.ShowAlignToIntegerMenu}" CommandParameter="{Binding $self}" HorizontalAlignment="Right" Tag="{Binding #imageHeightTextBox}" ToolTip.Tip="{asXaml:StringResource SessionControl.AlignToInteger}" VerticalAlignment="Center">
															<Panel>
																<Image Classes="Icon" IsVisible="{Binding !$parent[ToggleButton].IsChecked}" Source="{StaticResource Image/Icon.Alignment.Vertical}"/>
																<Image Classes="Icon" IsVisible="{Binding $parent[ToggleButton].IsChecked}" Source="{StaticResource Image/Icon.Alignment.Vertical.Light}"/>
															</Panel>
														</ToggleButton>
													</Panel>
												</abControls:IntegerTextBox.InnerRightContent>
											</abControls:IntegerTextBox>
										</Panel>
									</Grid>
									<Separator asControls:DialogElement.SeparatorType="Small" IsVisible="{Binding !IsCompressedImageFormat}"/>
									<ToggleButton Name="evaluateImageDimensionsButton" 
									              Classes="SessionControl_SidePanel_ToggleButton" 
									              Command="{Binding #root.ShowEvaluateImageDimensionsMenuCommand}" 
									              IsVisible="{Binding !IsCompressedImageFormat}">
										<Grid ColumnDefinitions="*,Auto">
											<TextBlock Classes="Button_Text" Text="{asXaml:StringResource SessionControl.EvaluateImageDimensions}"/>
											<Image Classes="Button_DropDownIcon" Grid.Column="1" IsVisible="{Binding !$parent[ToggleButton].IsChecked}" Source="{DynamicResource Image/Icon.DropDown.Down}"/>
											<Image Classes="Button_DropDownIcon" Grid.Column="1" IsVisible="{Binding $parent[ToggleButton].IsChecked}" Source="{DynamicResource Image/Icon.DropDown.Down.Light}"/>
										</Grid>
									</ToggleButton>
									<Separator asControls:DialogElement.SeparatorType="Small"/>

									<!-- Insets of source image, laid out by the edges they take in -->
									<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" Text="{asXaml:StringResource SessionControl.SourceInsets}"/>
									<Grid ColumnDefinitions="*,*,*" ColumnSpacing="3" RowDefinitions="Auto,Auto" RowSpacing="3">
										<abControls:IntegerTextBox Classes="Dialog_TextBox" 
										                           Grid.RowSpan="2"
										                           IsNullValueAllowed="False" 
										                           Maximum="65535" Minimum="0" 
										                           TextAlignment="Center" 
										                           ToolTip.Tip="{asXaml:StringResource SessionControl.SourceInsets.Left}" 
										                           Value="{Binding SourceInsetsLeft, Mode=TwoWay}"
										                           VerticalAlignment="Center"/>
										<abControls:IntegerTextBox Classes="Dialog_TextBox" 
										                           Grid.Column="1" 
										                           IsNullValueAllowed="False" 
										                           Maximum="65535" Minimum="0" 
										                           TextAlignment="Center" 
										                           ToolTip.Tip="{asXaml:StringResource SessionControl.SourceInsets.Top}" 
										                           Value="{Binding SourceInsetsTop, Mode=TwoWay}"/>
										<abControls:IntegerTextBox Classes="Dialog_TextBox" 
										                           Grid.Column="1" 
										                           Grid.Row="1" 
										                           IsNullValueAllowed="False" 
										                           Maximum="65535" 
										                           Minimum="0" 
										                           TextAlignment="Center" 
										                           ToolTip.Tip="{asXaml:StringResource SessionControl.SourceInsets.Bottom}" 
										                           Value="{Binding SourceInsetsBottom, Mode=TwoWay}"/>
										<abControls:IntegerTextBox Classes="Dialog_TextBox" 
										                           Grid.Column="2" 
										                           Grid.RowSpan="2" 
										                           IsNullValueAllowed="False" 
										                           Maximum="65535" 
										                           Minimum="0" 
										                           TextAlignment="Center" 
										                           ToolTip.Tip="{asXaml:StringResource SessionControl.SourceInsets.Right}" 
										                           Value="{Binding SourceInsetsRight, Mode=TwoWay}"
										                           VerticalAlignment="Center"/>
									</Grid>
									<Separator asControls:DialogElement.SeparatorType="Small"/>
								</StackPanel>
							</Expander>

							<!-- Plane options #1 -->
							<Expander Name="plane1ParamsExpander" Classes="SessionControl_SidePanel_Expander" Header="{asXaml:StringResource SessionControl.ImagePlaneOptions.1}" IsVisible="{Binding HasImagePlane1}">
								<StackPanel>
									<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" Text="{asXaml:StringResource SessionControl.RowStride}"/>
									<Panel>
										<abControls:IntegerTextBox Name="rowStride1TextBox" Classes="Dialog_TextBox" IsNullValueAllowed="False" Value="{Binding RowStride1, Mode=TwoWay}">
											<abControls:IntegerTextBox.InnerRightContent>
												<StackPanel Orientation="Horizontal">
													<TextBlock Classes="SessionControl_SidePanel_Unit" Text="{asXaml:StringResource Common.Bytes}"/>
													<Panel Classes="TextBox_InPlaceActions">
														<ToggleButton Name="alignRowStride1Button" Classes="TextBox_InPlaceAction" Command="{Binding #root.ShowAlignToIntegerMenu}" CommandParameter="{Binding $self}" HorizontalAlignment="Right" Tag="{Binding #rowStride1TextBox}" ToolTip.Tip="{asXaml:StringResource SessionControl.AlignToInteger}" VerticalAlignment="Center">
															<Panel>
																<Image Classes="Icon" IsVisible="{Binding !$parent[ToggleButton].IsChecked}" Source="{StaticResource Image/Icon.Alignment.Horizontal}"/>
																<Image Classes="Icon" IsVisible="{Binding $parent[ToggleButton].IsChecked}" Source="{StaticResource Image/Icon.Alignment.Horizontal.Light}"/>
															</Panel>
														</ToggleButton>
													</Panel>
												</StackPanel>
											</abControls:IntegerTextBox.InnerRightContent>
										</abControls:IntegerTextBox>
									</Panel>
									<Separator asControls:DialogElement.SeparatorType="Small" IsVisible="{Binding IsAdjustablePixelStride1}"/>
									<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" IsVisible="{Binding IsAdjustablePixelStride1}" Text="{asXaml:StringResource SessionControl.PixelStride}"/>
									<abControls:IntegerTextBox Classes="Dialog_TextBox" IsNullValueAllowed="False" IsVisible="{Binding IsAdjustablePixelStride1}" Value="{Binding PixelStride1, Mode=TwoWay}">
										<abControls:IntegerTextBox.InnerRightContent>
											<TextBlock Classes="SessionControl_SidePanel_Unit" Text="{asXaml:StringResource Common.Bytes}"/>
										</abControls:IntegerTextBox.InnerRightContent>
									</abControls:IntegerTextBox>
									<Separator asControls:DialogElement.SeparatorType="Small" IsVisible="{Binding IsAdjustableEffectiveBits1}"/>
									<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" IsVisible="{Binding IsAdjustableEffectiveBits1}" Text="{asXaml:StringResource SessionControl.EffectiveBits}"/>
									<abControls:IntegerTextBox Classes="Dialog_TextBox" IsEnabled="{Binding !HasColorTables}" IsNullValueAllowed="False" IsVisible="{Binding IsAdjustableEffectiveBits1}" Minimum="1" Value="{Binding EffectiveBits1, Mode=TwoWay}"/>
									<TextBlock asControls:DialogElement.TextRole="WarningDescriptionBelowInputControl" IsVisible="{asXaml:AndBindings {Binding IsAdjustableEffectiveBits1}, {Binding HasColorTables}}" Text="{asXaml:StringResource SessionControl.EffectiveBits.DisabledByColorTable}"/>
									<StackPanel IsVisible="{Binding AreAdjustableBlackWhiteLevels1}">
										<Separator asControls:DialogElement.SeparatorType="Small"/>
										<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" Text="{asXaml:StringResource SessionControl.BlackLevel}"/>
										<abControls:IntegerTextBox Classes="Dialog_TextBox" IsNullValueAllowed="False" Minimum="0" Value="{Binding BlackLevel1, Mode=TwoWay}"/>
										<Separator asControls:DialogElement.SeparatorType="Small"/>
										<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" Text="{asXaml:StringResource SessionControl.WhiteLevel}"/>
										<abControls:IntegerTextBox Classes="Dialog_TextBox" IsNullValueAllowed="False" Minimum="1" Value="{Binding WhiteLevel1, Mode=TwoWay}"/>
									</StackPanel>
									<Separator asControls:DialogElement.SeparatorType="Small"/>
								</StackPanel>
							</Expander>

							<!-- Plane options #2 -->
							<Expander Name="plane2ParamsExpander" Classes="SessionControl_SidePanel_Expander" Header="{asXaml:StringResource SessionControl.ImagePlaneOptions.2}" IsVisible="{Binding HasImagePlane2}">
								<StackPanel>
									<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" Text="{asXaml:StringResource SessionControl.RowStride}"/>
									<Panel>
										<abControls:IntegerTextBox Name="rowStride2TextBox" Classes="Dialog_TextBox" IsNullValueAllowed="False" Value="{Binding RowStride2, Mode=TwoWay}">
											<abControls:IntegerTextBox.InnerRightContent>
												<StackPanel Orientation="Horizontal">
													<TextBlock Classes="SessionControl_SidePanel_Unit" Text="{asXaml:StringResource Common.Bytes}"/>
													<Panel Classes="TextBox_InPlaceActions">
														<ToggleButton Name="alignRowStride2Button" Classes="TextBox_InPlaceAction" Command="{Binding #root.ShowAlignToIntegerMenu}" CommandParameter="{Binding $self}" HorizontalAlignment="Right" Tag="{Binding #rowStride2TextBox}" ToolTip.Tip="{asXaml:StringResource SessionControl.AlignToInteger}" VerticalAlignment="Center">
															<Panel>
																<Image Classes="Icon" IsVisible="{Binding !$parent[ToggleButton].IsChecked}" Source="{StaticResource Image/Icon.Alignment.Horizontal}"/>
																<Image Classes="Icon" IsVisible="{Binding $parent[ToggleButton].IsChecked}" Source="{StaticResource Image/Icon.Alignment.Horizontal.Light}"/>
															</Panel>
														</ToggleButton>
													</Panel>
												</StackPanel>
											</abControls:IntegerTextBox.InnerRightContent>
										</abControls:IntegerTextBox>
									</Panel>
									<Separator asControls:DialogElement.SeparatorType="Small" IsVisible="{Binding IsAdjustablePixelStride2}"/>
									<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" IsVisible="{Binding IsAdjustablePixelStride2}" Text="{asXaml:StringResource SessionControl.PixelStride}"/>
									<abControls:IntegerTextBox Classes="Dialog_TextBox" IsNullValueAllowed="False" IsVisible="{Binding IsAdjustablePixelStride2}" Value="{Binding PixelStride2, Mode=TwoWay}">
										<abControls:IntegerTextBox.InnerRightContent>
											<TextBlock Classes="SessionControl_SidePanel_Unit" Text="{asXaml:StringResource Common.Bytes}"/>
										</abControls:IntegerTextBox.InnerRightContent>
									</abControls:IntegerTextBox>
									<Separator asControls:DialogElement.SeparatorType="Small" IsVisible="{Binding IsAdjustableEffectiveBits2}"/>
									<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" IsVisible="{Binding IsAdjustableEffectiveBits2}" Text="{asXaml:StringResource SessionControl.EffectiveBits}"/>
									<abControls:IntegerTextBox Classes="Dialog_TextBox" IsEnabled="{Binding !HasColorTables}" IsNullValueAllowed="False" IsVisible="{Binding IsAdjustableEffectiveBits2}" Minimum="1" Value="{Binding EffectiveBits2, Mode=TwoWay}"/>
									<TextBlock asControls:DialogElement.TextRole="WarningDescriptionBelowInputControl" IsVisible="{asXaml:AndBindings {Binding IsAdjustableEffectiveBits2}, {Binding HasColorTables}}" Text="{asXaml:StringResource SessionControl.EffectiveBits.DisabledByColorTable}"/>
									<StackPanel IsVisible="{Binding AreAdjustableBlackWhiteLevels2}">
										<Separator asControls:DialogElement.SeparatorType="Small"/>
										<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" Text="{asXaml:StringResource SessionControl.BlackLevel}"/>
										<abControls:IntegerTextBox Classes="Dialog_TextBox" IsNullValueAllowed="False" Minimum="0" Value="{Binding BlackLevel2, Mode=TwoWay}"/>
										<Separator asControls:DialogElement.SeparatorType="Small"/>
										<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" Text="{asXaml:StringResource SessionControl.WhiteLevel}"/>
										<abControls:IntegerTextBox Classes="Dialog_TextBox" IsNullValueAllowed="False" Minimum="1" Value="{Binding WhiteLevel2, Mode=TwoWay}"/>
									</StackPanel>
									<Separator asControls:DialogElement.SeparatorType="Small"/>
								</StackPanel>
							</Expander>

							<!-- Plane options #3 -->
							<Expander Name="plane3ParamsExpander" Classes="SessionControl_SidePanel_Expander" Header="{asXaml:StringResource SessionControl.ImagePlaneOptions.3}" IsVisible="{Binding HasImagePlane3}">
								<StackPanel>
									<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" Text="{asXaml:StringResource SessionControl.RowStride}"/>
									<Panel>
										<abControls:IntegerTextBox Name="rowStride3TextBox" Classes="Dialog_TextBox" IsNullValueAllowed="False" Value="{Binding RowStride3, Mode=TwoWay}">
											<abControls:IntegerTextBox.InnerRightContent>
												<StackPanel Orientation="Horizontal">
													<TextBlock Classes="SessionControl_SidePanel_Unit" Text="{asXaml:StringResource Common.Bytes}"/>
													<Panel Classes="TextBox_InPlaceActions">
														<ToggleButton Name="alignRowStride3Button" Classes="TextBox_InPlaceAction" Command="{Binding #root.ShowAlignToIntegerMenu}" CommandParameter="{Binding $self}" HorizontalAlignment="Right" Tag="{Binding #rowStride3TextBox}" ToolTip.Tip="{asXaml:StringResource SessionControl.AlignToInteger}" VerticalAlignment="Center">
															<Panel>
																<Image Classes="Icon" IsVisible="{Binding !$parent[ToggleButton].IsChecked}" Source="{StaticResource Image/Icon.Alignment.Horizontal}"/>
																<Image Classes="Icon" IsVisible="{Binding $parent[ToggleButton].IsChecked}" Source="{StaticResource Image/Icon.Alignment.Horizontal.Light}"/>
															</Panel>
														</ToggleButton>
													</Panel>
												</StackPanel>
											</abControls:IntegerTextBox.InnerRightContent>
										</abControls:IntegerTextBox>
									</Panel>
									<Separator asControls:DialogElement.SeparatorType="Small" IsVisible="{Binding IsAdjustablePixelStride3}"/>
									<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" IsVisible="{Binding IsAdjustablePixelStride3}" Text="{asXaml:StringResource SessionControl.PixelStride}"/>
									<abControls:IntegerTextBox Classes="Dialog_TextBox" IsNullValueAllowed="False" IsVisible="{Binding IsAdjustablePixelStride3}" Value="{Binding PixelStride3, Mode=TwoWay}">
										<abControls:IntegerTextBox.InnerRightContent>
											<TextBlock Classes="SessionControl_SidePanel_Unit" Text="{asXaml:StringResource Common.Bytes}"/>
										</abControls:IntegerTextBox.InnerRightContent>
									</abControls:IntegerTextBox>
									<Separator asControls:DialogElement.SeparatorType="Small" IsVisible="{Binding IsAdjustableEffectiveBits3}"/>
									<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" IsVisible="{Binding IsAdjustableEffectiveBits3}" Text="{asXaml:StringResource SessionControl.EffectiveBits}"/>
									<abControls:IntegerTextBox Classes="Dialog_TextBox" IsEnabled="{Binding !HasColorTables}" IsNullValueAllowed="False" IsVisible="{Binding IsAdjustableEffectiveBits3}" Minimum="1" Value="{Binding EffectiveBits3, Mode=TwoWay}"/>
									<TextBlock asControls:DialogElement.TextRole="WarningDescriptionBelowInputControl" IsVisible="{asXaml:AndBindings {Binding IsAdjustableEffectiveBits3}, {Binding HasColorTables}}" Text="{asXaml:StringResource SessionControl.EffectiveBits.DisabledByColorTable}"/>
									<StackPanel IsVisible="{Binding AreAdjustableBlackWhiteLevels3}">
										<Separator asControls:DialogElement.SeparatorType="Small"/>
										<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" Text="{asXaml:StringResource SessionControl.BlackLevel}"/>
										<abControls:IntegerTextBox Classes="Dialog_TextBox" IsNullValueAllowed="False" Minimum="0" Value="{Binding BlackLevel3, Mode=TwoWay}"/>
										<Separator asControls:DialogElement.SeparatorType="Small"/>
										<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" Text="{asXaml:StringResource SessionControl.WhiteLevel}"/>
										<abControls:IntegerTextBox Classes="Dialog_TextBox" IsNullValueAllowed="False" Minimum="1" Value="{Binding WhiteLevel3, Mode=TwoWay}"/>
									</StackPanel>
									<Separator asControls:DialogElement.SeparatorType="Small"/>
								</StackPanel>
							</Expander>

							<!-- Color -->
							<Expander Name="colorParamsExpander" Classes="SessionControl_SidePanel_Expander">
								<Expander.Header>
									<Grid ColumnDefinitions="Auto,*">
										<TextBlock Text="{asXaml:StringResource SessionControl.RenderingParametersPanel.Color}" VerticalAlignment="Center"/>
										<TextBlock Classes="SessionControl_SidePanel_Expander_Summary" Grid.Column="1" IsVisible="{Binding !$parent[Expander].IsExpanded}" Text="{Binding ColorSpace, Converter={x:Static appConverters:ColorSpaceToStringConverter.Default}}"/>
									</Grid>
								</Expander.Header>
								<StackPanel>
									<!-- Color space -->
									<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" Text="{asXaml:StringResource SessionControl.ColorSpace}"/>
									<Panel>
										<abControls:LinkTextBlock Command="{Binding #root.ShowColorSpaceManagementOptions}" IsVisible="{Binding !IsColorSpaceManagementEnabled}" Text="{asXaml:StringResource SessionControl.ColorSpace.Disabled}" TextWrapping="Wrap"/>
										<StackPanel IsVisible="{Binding IsColorSpaceManagementEnabled}">
											<Grid ColumnDefinitions="*,Auto">
												<ComboBox Name="colorSpaceComboBox" Classes="Dialog_ComboBox" ItemsSource="{Binding ColorSpaces}" ItemsPanel="{StaticResource ItemsPanelTemplate/StackPanel}" SelectedItem="{Binding ColorSpace, Mode=TwoWay}" VerticalAlignment="Center">
													<ComboBox.ItemTemplate>
														<DataTemplate>
															<Grid ColumnDefinitions="*,Auto">
																<TextBlock Text="{Binding Converter={x:Static appConverters:ColorSpaceToStringConverter.Default}}" VerticalAlignment="Center"/>
																<Border Background="{DynamicResource Brush/SessionControl.ColorSpaceLabel.Background.EmbeddedInFile}" 
																        BorderBrush="{DynamicResource Brush/SessionControl.ColorSpaceLabel.Border.EmbeddedInFile}" 
																        BorderThickness="{StaticResource Thickness/SessionControl.ImageFormatCategoryLabel.Border}" 
																        CornerRadius="{StaticResource CornerRadius/SessionControl.ImageFormatCategoryLabel}" 
																        Grid.Column="1" 
																        IsVisible="{Binding IsEmbedded}" 
																        Margin="{StaticResource Thickness/SessionControl.ImageFormatCategoryLabel.Margin}" 
																        Padding="{StaticResource Thickness/SessionControl.ImageFormatCategoryLabel.Padding}"
																        VerticalAlignment="Center">
																	<TextBlock FontSize="{StaticResource Double/SessionControl.ImageFormatCategoryLabel.FontSize}" FontWeight="Bold" Foreground="{DynamicResource Brush/SessionControl.ImageFormatCategoryLabel.Foreground}" Text="{asXaml:StringResource SessionControl.ColorSpace.Embedded}"/>
																</Border>
																<Border Background="{DynamicResource Brush/SessionControl.ColorSpaceLabel.Background.SystemDefined}" 
																        BorderBrush="{DynamicResource Brush/SessionControl.ColorSpaceLabel.Border.SystemDefined}" 
																        BorderThickness="{StaticResource Thickness/SessionControl.ImageFormatCategoryLabel.Border}" 
																        CornerRadius="{DynamicResource CornerRadius/SessionControl.ImageFormatCategoryLabel}" 
																        Grid.Column="1" 
																        IsVisible="{Binding IsSystemDefined}" 
																        Margin="{StaticResource Thickness/SessionControl.ImageFormatCategoryLabel.Margin}" 
																        Opacity="{Binding $self.IsEffectivelyEnabled, Converter={x:Static appControls:SessionControl.BooleanToImageFormatCategoryLabelOpacityConverter}}"
																        Padding="{StaticResource Thickness/SessionControl.ImageFormatCategoryLabel.Padding}" 
																        VerticalAlignment="Center">
																	<TextBlock FontSize="{StaticResource Double/SessionControl.ImageFormatCategoryLabel.FontSize}" FontWeight="Bold" Foreground="{DynamicResource Brush/SessionControl.ImageFormatCategoryLabel.Foreground}" Text="{asXaml:StringResource SessionControl.ColorSpace.SystemDefined}"/>
																</Border>
																<Border Background="{DynamicResource Brush/SessionControl.ColorSpaceLabel.Background.Custom}" 
																        BorderBrush="{DynamicResource Brush/SessionControl.ColorSpaceLabel.Border.Custom}" 
																        BorderThickness="{StaticResource Thickness/SessionControl.ImageFormatCategoryLabel.Border}" 
																        CornerRadius="{StaticResource CornerRadius/SessionControl.ImageFormatCategoryLabel}" 
																        Grid.Column="1"
																        IsVisible="{Binding IsUserDefined}" 
																        Margin="{StaticResource Thickness/SessionControl.ImageFormatCategoryLabel.Margin}" 
																        Opacity="{Binding $self.IsEffectivelyEnabled, Converter={x:Static appControls:SessionControl.BooleanToImageFormatCategoryLabelOpacityConverter}}"
																        Padding="{StaticResource Thickness/SessionControl.ImageFormatCategoryLabel.Padding}" 
																        VerticalAlignment="Center">
																	<TextBlock FontSize="{StaticResource Double/SessionControl.ImageFormatCategoryLabel.FontSize}" FontWeight="Bold" Foreground="{DynamicResource Brush/SessionControl.ImageFormatCategoryLabel.Foreground}" Text="{asXaml:StringResource Common.Custom}"/>
																</Border>
															</Grid>
														</DataTemplate>
													</ComboBox.ItemTemplate>
												</ComboBox>
												<Button Classes="SessionControl_SidePanel_InlineButton" Command="{Binding #root.ShowColorSpaceInfo}" Grid.Column="1" asControls:ToolbarElement.Role="Button" ToolTip.Tip="{asXaml:StringResource Common.Details}">
													<Image asControls:ToolbarElement.Role="SmallIcon" Source="{DynamicResource Image/Icon.Information.Outline}"/>
												</Button>
											</Grid>
											<Separator asControls:DialogElement.SeparatorType="Small" IsVisible="{Binding !ColorSpace.IsLinear}"/>
											<Grid Classes="SessionControl_SidePanel_SwitchItem" ColumnDefinitions="*,Auto" IsVisible="{Binding !ColorSpace.IsLinear}">
												<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" Text="{asXaml:StringResource SessionControl.UseLinearColorSpace}" VerticalAlignment="Center"/>
												<ToggleSwitch Grid.Column="1" IsChecked="{Binding UseLinearColorSpace, Mode=TwoWay}" asControls:DialogElement.IsDialogItemInput="True"/>
											</Grid>
										</StackPanel>
									</Panel>
									<Separator asControls:DialogElement.SeparatorType="Small"/>

									<!-- RGB gain -->
									<StackPanel IsVisible="{Binding IsRgbGainSupported}">
										<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" Text="{asXaml:StringResource SessionControl.RedColorGain}"/>
										<abControls:RealNumberTextBox Classes="Dialog_TextBox" 
										                              DecimalPlaces="4"
										                              DefaultValue="1" 
										                              Increment="0.1"
										                              IsNullValueAllowed="False" 
										                              Maximum="{x:Static appControls:SessionControl.MaxRgbGain}" 
										                              MinDecimalPlaces="4"
										                              Minimum="{x:Static appControls:SessionControl.MinRgbGain}" 
										                              Value="{Binding RedColorGain, Mode=TwoWay}"/>
										<Separator asControls:DialogElement.SeparatorType="Small"/>
										<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" Text="{asXaml:StringResource SessionControl.GreenColorGain}"/>
										<abControls:RealNumberTextBox Classes="Dialog_TextBox" 
										                              DecimalPlaces="4"
										                              DefaultValue="1" 
										                              Increment="0.1"
										                              IsNullValueAllowed="False" 
										                              Maximum="{x:Static appControls:SessionControl.MaxRgbGain}" 
										                              MinDecimalPlaces="4"
										                              Minimum="{x:Static appControls:SessionControl.MinRgbGain}" 
										                              Value="{Binding GreenColorGain, Mode=TwoWay}"/>
										<Separator asControls:DialogElement.SeparatorType="Small"/>
										<TextBlock asControls:DialogElement.TextRole="LabelAboveInputControl" Text="{asXaml:StringResource SessionControl.BlueColorGain}"/>
										<abControls:RealNumberTextBox Classes="Dialog_TextBox" 
										                              DecimalPlaces="4"
										                              DefaultValue="1" 
										                              Increment="0.1"
										                              IsNullValueAllowed="False" 
										                              Maximum="{x:Static appControls:SessionControl.MaxRgbGain}" 
										                              MinDecimalPlaces="4"
										                              Minimum="{x:Static appControls:SessionControl.MinRgbGain}" 
										                              Value="{Binding BlueColorGain, Mode=TwoWay}"/>
										<Separator asControls:DialogElement.SeparatorType="Small"/>
										<Button Classes="SessionControl_SidePanel_Button" Command="{Binding SelectRgbGainCommand}" Content="{asXaml:StringResource SessionControl.SelectRgbGain}"/>
										<Separator asControls:DialogElement.SeparatorType="Small"/>
										<Button Classes="SessionControl_SidePanel_Button" Command="{Binding ResetRgbGainCommand}" Content="{asXaml:StringResource SessionControl.ResetRgbGain}"/>
										<Separator asControls:DialogElement.SeparatorType="Small"/>
									</StackPanel>
								</StackPanel>
							</Expander>

						</StackPanel>
					</ScrollViewer>

				</DockPanel>

				<!-- Filter panel -->
				<DockPanel IsVisible="{Binding IsFilterPanelVisible}">

					<!-- Resources -->
					<DockPanel.Resources>
						<StaticResourceExtension x:Key="Double/Dialog.Separator.Height.Small" ResourceKey="Double/SessionControl.SidePanel.Separator.Height.Small"/>
						<SolidColorBrush x:Key="SliderTrackValueFill" Color="Transparent"/>
						<SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="Transparent"/>
					</DockPanel.Resources>

					<!-- Styles -->
					<DockPanel.Styles>
						<Style Selector="TextBlock">
							<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
						</Style>
					</DockPanel.Styles>

					<!-- Filter actions -->
					<Border Classes="SessionControl_SidePanel_ActionsPanel" DockPanel.Dock="Bottom" IsEnabled="{Binding IsSourceOpened}">
						<Grid ColumnDefinitions="Auto,*,Auto,Auto">

							<!-- Reset filters -->
							<Button Command="{Binding ResetFiltersCommand}" asControls:ToolbarElement.Role="Button" ToolTip.Placement="Top" ToolTip.Tip="{asXaml:StringResource SessionControl.ResetFilters}" ToolTip.VerticalOffset="0">
								<Image asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.Reset}"/>
							</Button>


						</Grid>
					</Border>

					<!-- Parameters -->
					<ScrollViewer HorizontalScrollBarVisibility="Disabled">
						<StackPanel Margin="{StaticResource Thickness/SessionControl.SidePanel.Padding}">

							<!-- Brightness -->
							<Expander Name="brightnessFilterParamsExpander" Classes="SessionControl_SidePanel_Expander" Header="{asXaml:StringResource SessionControl.FilterPanel.Brightness}">
								<StackPanel IsEnabled="{Binding IsBrightnessAdjustmentSupported}">
									<!-- Brightness -->
									<abControls:FormattedTextBlock Arg1="{Binding BrightnessAdjustment, StringFormat={}{0:+0.00;-0.00} EV}" Format="{asXaml:StringResource SessionControl.BrightnessAndContrastAdjustment.Label.Brightness}" asControls:DialogElement.TextRole="LabelAboveInputControl"/>
									<Grid ColumnDefinitions="Auto,*,Auto">
										<RepeatButton Name="brightnessAdjustmentDecreaseButton" Classes="SessionControl_FilterParamsSlider_SmallChangeButton_Decrease" Command="{Binding #root.DecreaseSliderValueCommand}" CommandParameter="{Binding #brightnessAdjustmentSlider}">
											<Image Classes="Icon" Source="{StaticResource Image/Icon.Backward}"/>
										</RepeatButton>
										<appControls:CenterFilledSlider Name="brightnessAdjustmentSlider" Classes="SessionControl_FilterParamsSlider" Grid.Column="1" TrackBrush="{DynamicResource Brush/SessionControl.FilterParamsSlider.Track.Brightness}" Maximum="2" Minimum="-2" TickFrequency="0.05" Value="{Binding BrightnessAdjustment, Mode=TwoWay}"/>
										<RepeatButton Name="brightnessAdjustmentIncreaseButton" Classes="SessionControl_FilterParamsSlider_SmallChangeButton_Increase" Command="{Binding #root.IncreaseSliderValueCommand}" CommandParameter="{Binding #brightnessAdjustmentSlider}" Grid.Column="2">
											<Image Classes="Icon" Source="{StaticResource Image/Icon.Forward}"/>
										</RepeatButton>
									</Grid>
									<Separator asControls:DialogElement.SeparatorType="Default"/>

									<!-- Contrast -->
									<abControls:FormattedTextBlock Arg1="{Binding ContrastAdjustment, StringFormat={}{0:+0.00;-0.00}}" Format="{asXaml:StringResource SessionControl.BrightnessAndContrastAdjustment.Label.Contrast}" asControls:DialogElement.TextRole="LabelAboveInputControl"/>
									<Grid ColumnDefinitions="Auto,*,Auto">
										<RepeatButton Name="contrastAdjustmentDecreaseButton" Classes="SessionControl_FilterParamsSlider_SmallChangeButton_Decrease" Command="{Binding #root.DecreaseSliderValueCommand}" CommandParameter="{Binding #contrastAdjustmentSlider}">
											<Image Classes="Icon" Source="{StaticResource Image/Icon.Backward}"/>
										</RepeatButton>
										<appControls:CenterFilledSlider Name="contrastAdjustmentSlider" Classes="SessionControl_FilterParamsSlider" Grid.Column="1" TrackBrush="{DynamicResource Brush/SessionControl.FilterParamsSlider.Track.Brightness}" Maximum="1" Minimum="-1" TickFrequency="0.01" Value="{Binding ContrastAdjustment, Mode=TwoWay}"/>
										<RepeatButton Name="contrastAdjustmentIncreaseButton" Classes="SessionControl_FilterParamsSlider_SmallChangeButton_Increase" Command="{Binding #root.IncreaseSliderValueCommand}" CommandParameter="{Binding #contrastAdjustmentSlider}" Grid.Column="2">
											<Image Classes="Icon" Source="{StaticResource Image/Icon.Forward}"/>
										</RepeatButton>
									</Grid>
									<Separator asControls:DialogElement.SeparatorType="Default"/>

									<!-- Highlight -->
									<abControls:FormattedTextBlock Arg1="{Binding HighlightAdjustment, StringFormat={}{0:+0.00;-0.00}}" Format="{asXaml:StringResource SessionControl.BrightnessAndContrastAdjustment.Label.Highlight}" asControls:DialogElement.TextRole="LabelAboveInputControl"/>
									<Grid ColumnDefinitions="Auto,*,Auto">
										<RepeatButton Name="highlightAdjustmentDecreaseButton" Classes="SessionControl_FilterParamsSlider_SmallChangeButton_Decrease" Command="{Binding #root.DecreaseSliderValueCommand}" CommandParameter="{Binding #highlightAdjustmentSlider}">
											<Image Classes="Icon" Source="{StaticResource Image/Icon.Backward}"/>
										</RepeatButton>
										<appControls:CenterFilledSlider Name="highlightAdjustmentSlider" Classes="SessionControl_FilterParamsSlider" Grid.Column="1" TrackBrush="{DynamicResource Brush/SessionControl.FilterParamsSlider.Track.Brightness}" Maximum="1" Minimum="-1" TickFrequency="0.01" Value="{Binding HighlightAdjustment, Mode=TwoWay}"/>
										<RepeatButton Name="highlightAdjustmentIncreaseButton" Classes="SessionControl_FilterParamsSlider_SmallChangeButton_Increase" Command="{Binding #root.IncreaseSliderValueCommand}" CommandParameter="{Binding #highlightAdjustmentSlider}" Grid.Column="2">
											<Image Classes="Icon" Source="{StaticResource Image/Icon.Forward}"/>
										</RepeatButton>
									</Grid>
									<Separator asControls:DialogElement.SeparatorType="Default"/>

									<!-- Shadow -->
									<abControls:FormattedTextBlock Arg1="{Binding ShadowAdjustment, StringFormat={}{0:+0.00;-0.00}}" Format="{asXaml:StringResource SessionControl.BrightnessAndContrastAdjustment.Label.Shadow}" asControls:DialogElement.TextRole="LabelAboveInputControl"/>
									<Grid ColumnDefinitions="Auto,*,Auto">
										<RepeatButton Name="shadowAdjustmentDecreaseButton" Classes="SessionControl_FilterParamsSlider_SmallChangeButton_Decrease" Command="{Binding #root.DecreaseSliderValueCommand}" CommandParameter="{Binding #shadowAdjustmentSlider}">
											<Image Classes="Icon" Source="{StaticResource Image/Icon.Backward}"/>
										</RepeatButton>
										<appControls:CenterFilledSlider Name="shadowAdjustmentSlider" Classes="SessionControl_FilterParamsSlider" Grid.Column="1" TrackBrush="{DynamicResource Brush/SessionControl.FilterParamsSlider.Track.Brightness}" Maximum="1" Minimum="-1" TickFrequency="0.01" Value="{Binding ShadowAdjustment, Mode=TwoWay}"/>
										<RepeatButton Name="shadowAdjustmentIncreaseButton" Classes="SessionControl_FilterParamsSlider_SmallChangeButton_Increase" Command="{Binding #root.IncreaseSliderValueCommand}" CommandParameter="{Binding #shadowAdjustmentSlider}" Grid.Column="2">
											<Image Classes="Icon" Source="{StaticResource Image/Icon.Forward}"/>
										</RepeatButton>
									</Grid>
									<Separator asControls:DialogElement.SeparatorType="Default"/>
									<Button Classes="SessionControl_SidePanel_Button" Command="{Binding SelectBrightnessAdjustmentCommand}" Content="{asXaml:StringResource SessionControl.AutoAdjust}"/>
									<Separator asControls:DialogElement.SeparatorType="Small"/>
								</StackPanel>
							</Expander>

							<!-- Color -->
							<Expander Name="colorFilterParamsExpander" Classes="SessionControl_SidePanel_Expander" Header="{asXaml:StringResource SessionControl.FilterPanel.Color}">
								<StackPanel IsEnabled="{Binding IsColorAdjustmentSupported}">
									<!-- Warmth -->
									<abControls:FormattedTextBlock Arg1="{Binding WarmthAdjustment, StringFormat={}{0:+0.00;-0.00}}" Format="{asXaml:StringResource SessionControl.ColorAdjustment.Label.Warmth}" asControls:DialogElement.TextRole="LabelAboveInputControl"/>
									<Grid ColumnDefinitions="Auto,*,Auto">
										<RepeatButton Name="warmthAdjustmentDecreaseButton" Classes="SessionControl_FilterParamsSlider_SmallChangeButton_Decrease" Command="{Binding #root.DecreaseSliderValueCommand}" CommandParameter="{Binding #warmthAdjustmentSlider}">
											<Image Classes="Icon" Source="{StaticResource Image/Icon.Backward}"/>
										</RepeatButton>
										<appControls:CenterFilledSlider Name="warmthAdjustmentSlider" Classes="SessionControl_FilterParamsSlider" Grid.Column="1" TrackBrush="{DynamicResource Brush/SessionControl.FilterParamsSlider.Track.Warmth}" Maximum="1" Minimum="-1" TickFrequency="0.01" Value="{Binding WarmthAdjustment, Mode=TwoWay}"/>
										<RepeatButton Name="warmthAdjustmentIncreaseButton" Classes="SessionControl_FilterParamsSlider_SmallChangeButton_Increase" Command="{Binding #root.IncreaseSliderValueCommand}" CommandParameter="{Binding #warmthAdjustmentSlider}" Grid.Column="2">
											<Image Classes="Icon" Source="{StaticResource Image/Icon.Forward}"/>
										</RepeatButton>
									</Grid>
									<Separator asControls:DialogElement.SeparatorType="Default"/>

									<!-- Tint -->
									<abControls:FormattedTextBlock Arg1="{Binding TintAdjustment, StringFormat={}{0:+0.00;-0.00}}" Format="{asXaml:StringResource SessionControl.ColorAdjustment.Label.Tint}" asControls:DialogElement.TextRole="LabelAboveInputControl"/>
									<Grid ColumnDefinitions="Auto,*,Auto">
										<RepeatButton Name="tintAdjustmentDecreaseButton" Classes="SessionControl_FilterParamsSlider_SmallChangeButton_Decrease" Command="{Binding #root.DecreaseSliderValueCommand}" CommandParameter="{Binding #tintAdjustmentSlider}">
											<Image Classes="Icon" Source="{StaticResource Image/Icon.Backward}"/>
										</RepeatButton>
										<appControls:CenterFilledSlider Name="tintAdjustmentSlider" Classes="SessionControl_FilterParamsSlider" Grid.Column="1" TrackBrush="{DynamicResource Brush/SessionControl.FilterParamsSlider.Track.Tint}" Maximum="1" Minimum="-1" TickFrequency="0.01" Value="{Binding TintAdjustment, Mode=TwoWay}"/>
										<RepeatButton Name="tintAdjustmentIncreaseButton" Classes="SessionControl_FilterParamsSlider_SmallChangeButton_Increase" Command="{Binding #root.IncreaseSliderValueCommand}" CommandParameter="{Binding #tintAdjustmentSlider}" Grid.Column="2">
											<Image Classes="Icon" Source="{StaticResource Image/Icon.Forward}"/>
										</RepeatButton>
									</Grid>
									<Separator asControls:DialogElement.SeparatorType="Default"/>

									<!-- Red -->
									<abControls:FormattedTextBlock Arg1="{Binding RedColorAdjustment, StringFormat={}{0:+0.00;-0.00}}" Format="{asXaml:StringResource SessionControl.ColorAdjustment.Label.Red}" asControls:DialogElement.TextRole="LabelAboveInputControl"/>
									<Grid ColumnDefinitions="Auto,*,Auto">
										<RepeatButton Name="redColorAdjustmentDecreaseButton" Classes="SessionControl_FilterParamsSlider_SmallChangeButton_Decrease" Command="{Binding #root.DecreaseSliderValueCommand}" CommandParameter="{Binding #redColorAdjustmentSlider}">
											<Image Classes="Icon" Source="{StaticResource Image/Icon.Backward}"/>
										</RepeatButton>
										<appControls:CenterFilledSlider Name="redColorAdjustmentSlider" Classes="SessionControl_FilterParamsSlider" Grid.Column="1" TrackBrush="{DynamicResource Brush/SessionControl.FilterParamsSlider.Track.Red}" Maximum="1" Minimum="-1" TickFrequency="0.01" Value="{Binding RedColorAdjustment, Mode=TwoWay}"/>
										<RepeatButton Name="redColorAdjustmentIncreaseButton" Classes="SessionControl_FilterParamsSlider_SmallChangeButton_Increase" Command="{Binding #root.IncreaseSliderValueCommand}" CommandParameter="{Binding #redColorAdjustmentSlider}" Grid.Column="2">
											<Image Classes="Icon" Source="{StaticResource Image/Icon.Forward}"/>
										</RepeatButton>
									</Grid>
									<Separator asControls:DialogElement.SeparatorType="Default"/>

									<!-- Green -->
									<abControls:FormattedTextBlock Arg1="{Binding GreenColorAdjustment, StringFormat={}{0:+0.00;-0.00}}" Format="{asXaml:StringResource SessionControl.ColorAdjustment.Label.Green}" asControls:DialogElement.TextRole="LabelAboveInputControl"/>
									<Grid ColumnDefinitions="Auto,*,Auto">
										<RepeatButton Name="greenColorAdjustmentDecreaseButton" Classes="SessionControl_FilterParamsSlider_SmallChangeButton_Decrease" Command="{Binding #root.DecreaseSliderValueCommand}" CommandParameter="{Binding #greenColorAdjustmentSlider}">
											<Image Classes="Icon" Source="{StaticResource Image/Icon.Backward}"/>
										</RepeatButton>
										<appControls:CenterFilledSlider Name="greenColorAdjustmentSlider" Classes="SessionControl_FilterParamsSlider" Grid.Column="1" TrackBrush="{DynamicResource Brush/SessionControl.FilterParamsSlider.Track.Green}" Maximum="1" Minimum="-1" TickFrequency="0.01" Value="{Binding GreenColorAdjustment, Mode=TwoWay}"/>
										<RepeatButton Name="greenColorAdjustmentIncreaseButton" Classes="SessionControl_FilterParamsSlider_SmallChangeButton_Increase" Command="{Binding #root.IncreaseSliderValueCommand}" CommandParameter="{Binding #greenColorAdjustmentSlider}" Grid.Column="2">
											<Image Classes="Icon" Source="{StaticResource Image/Icon.Forward}"/>
										</RepeatButton>
									</Grid>
									<Separator asControls:DialogElement.SeparatorType="Default"/>

									<!-- Blue -->
									<abControls:FormattedTextBlock Arg1="{Binding BlueColorAdjustment, StringFormat={}{0:+0.00;-0.00}}" Format="{asXaml:StringResource SessionControl.ColorAdjustment.Label.Blue}" asControls:DialogElement.TextRole="LabelAboveInputControl"/>
									<Grid ColumnDefinitions="Auto,*,Auto">
										<RepeatButton Name="blueColorAdjustmentDecreaseButton" Classes="SessionControl_FilterParamsSlider_SmallChangeButton_Decrease" Command="{Binding #root.DecreaseSliderValueCommand}" CommandParameter="{Binding #blueColorAdjustmentSlider}">
											<Image Classes="Icon" Source="{StaticResource Image/Icon.Backward}"/>
										</RepeatButton>
										<appControls:CenterFilledSlider Name="blueColorAdjustmentSlider" Classes="SessionControl_FilterParamsSlider" Grid.Column="1" TrackBrush="{DynamicResource Brush/SessionControl.FilterParamsSlider.Track.Blue}" Maximum="1" Minimum="-1" TickFrequency="0.01" Value="{Binding BlueColorAdjustment, Mode=TwoWay}"/>
										<RepeatButton Name="blueColorAdjustmentIncreaseButton" Classes="SessionControl_FilterParamsSlider_SmallChangeButton_Increase" Command="{Binding #root.IncreaseSliderValueCommand}" CommandParameter="{Binding #blueColorAdjustmentSlider}" Grid.Column="2">
											<Image Classes="Icon" Source="{StaticResource Image/Icon.Forward}"/>
										</RepeatButton>
									</Grid>
									<Separator asControls:DialogElement.SeparatorType="Default"/>

									<!-- Saturation -->
									<abControls:FormattedTextBlock Arg1="{Binding SaturationAdjustment, StringFormat={}{0:+0.00;-0.00}}" Format="{asXaml:StringResource SessionControl.ColorAdjustment.Label.Saturation}" asControls:DialogElement.TextRole="LabelAboveInputControl"/>
									<Grid ColumnDefinitions="Auto,*,Auto">
										<RepeatButton Name="saturationAdjustmentDecreaseButton" Classes="SessionControl_FilterParamsSlider_SmallChangeButton_Decrease" Command="{Binding #root.DecreaseSliderValueCommand}" CommandParameter="{Binding #saturationAdjustmentSlider}">
											<Image Classes="Icon" Source="{StaticResource Image/Icon.Backward}"/>
										</RepeatButton>
										<appControls:CenterFilledSlider Name="saturationAdjustmentSlider" Classes="SessionControl_FilterParamsSlider" Grid.Column="1" TrackBrush="{DynamicResource Brush/SessionControl.FilterParamsSlider.Track.Saturation}" Maximum="1" Minimum="-1" TickFrequency="0.01" Value="{Binding SaturationAdjustment, Mode=TwoWay}"/>
										<RepeatButton Name="saturationAdjustmentIncreaseButton" Classes="SessionControl_FilterParamsSlider_SmallChangeButton_Increase" Command="{Binding #root.IncreaseSliderValueCommand}" CommandParameter="{Binding #saturationAdjustmentSlider}" Grid.Column="2">
											<Image Classes="Icon" Source="{StaticResource Image/Icon.Forward}"/>
										</RepeatButton>
									</Grid>
									<Separator asControls:DialogElement.SeparatorType="Default"/>

									<!-- Vibrance -->
									<abControls:FormattedTextBlock Arg1="{Binding VibranceAdjustment, StringFormat={}{0:+0.00;-0.00}}" Format="{asXaml:StringResource SessionControl.ColorAdjustment.Label.Vibrance}" asControls:DialogElement.TextRole="LabelAboveInputControl"/>
									<Grid ColumnDefinitions="Auto,*,Auto">
										<RepeatButton Name="vibranceAdjustmentDecreaseButton" Classes="SessionControl_FilterParamsSlider_SmallChangeButton_Decrease" Command="{Binding #root.DecreaseSliderValueCommand}" CommandParameter="{Binding #vibranceAdjustmentSlider}">
											<Image Classes="Icon" Source="{StaticResource Image/Icon.Backward}"/>
										</RepeatButton>
										<appControls:CenterFilledSlider Name="vibranceAdjustmentSlider" Classes="SessionControl_FilterParamsSlider" Grid.Column="1" TrackBrush="{DynamicResource Brush/SessionControl.FilterParamsSlider.Track.Saturation}" Maximum="1" Minimum="-1" TickFrequency="0.01" Value="{Binding VibranceAdjustment, Mode=TwoWay}"/>
										<RepeatButton Name="vibranceAdjustmentIncreaseButton" Classes="SessionControl_FilterParamsSlider_SmallChangeButton_Increase" Command="{Binding #root.IncreaseSliderValueCommand}" CommandParameter="{Binding #vibranceAdjustmentSlider}" Grid.Column="2">
											<Image Classes="Icon" Source="{StaticResource Image/Icon.Forward}"/>
										</RepeatButton>
									</Grid>
									<Separator asControls:DialogElement.SeparatorType="Default"/>
									<Button Classes="SessionControl_SidePanel_Button" Command="{Binding SelectColorAdjustmentCommand}" Content="{asXaml:StringResource SessionControl.AutoAdjust}"/>
									<Separator asControls:DialogElement.SeparatorType="Small"/>
								</StackPanel>
							</Expander>

						</StackPanel>
					</ScrollViewer>

				</DockPanel>

			</Panel>

			<!-- Splitter -->
			<GridSplitter Background="{DynamicResource Brush/WorkingArea.Panel.Background}"
			              BorderBrush="{DynamicResource Brush/WorkingArea.Panel.Border}"
			              BorderThickness="1,0,0,0"
			              Classes="GridSplitter_Vertical"
			              DragCompleted="OnSidePanelSplitterDragCompleted"
			              DragStarted="OnSidePanelSplitterDragStarted"
			              Grid.Column="3"
			              IsVisible="{Binding #sidePanelContainer.IsVisible}"/>

			<!-- Side panel toolbar -->
			<Border Classes="Toolbar" Background="{DynamicResource Brush/WorkingArea.Panel.Background}" BorderBrush="{DynamicResource Brush/WorkingArea.Panel.Border}" BorderThickness="1,0,0,0" Grid.Column="5">
				<StackPanel VerticalAlignment="Top">

					<!-- Test -->
					<Button Name="testButton" Command="{Binding #root.OnTestButtonClick}" IsVisible="False" asControls:ToolbarElement.Role="Button" ToolTip.Tip="Test">
						<Image asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.Lab}"/>
					</Button>

					<!-- Rendering parameters panel -->
					<ToggleButton IsChecked="{Binding IsRenderingParametersPanelVisible}" asControls:ToolbarElement.Role="Button" ToolTip.Tip="{asXaml:StringResource SessionControl.RenderingParametersPanel}">
						<Panel>
							<Image asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.Sliders}" IsVisible="{Binding !$parent[ToggleButton].IsChecked}"/>
							<Image asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.Sliders.Light}" IsVisible="{Binding $parent[ToggleButton].IsChecked}"/>
						</Panel>
					</ToggleButton>

					<!-- Filter panel -->
					<ToggleButton IsChecked="{Binding IsFilterPanelVisible}" asControls:ToolbarElement.Role="Button" ToolTip.Tip="{asXaml:StringResource SessionControl.FilterPanel}">
						<Panel>
							<Panel IsVisible="{Binding !$parent[ToggleButton].IsChecked}">
								<Image asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.ImageFilter}" IsVisible="{Binding !#activeFilterPanelButtonIcon.IsVisible}"/>
								<Image Name="activeFilterPanelButtonIcon" asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.ImageFilter.Active}">
									<Image.IsVisible>
										<MultiBinding Converter="{x:Static aConverters:BoolConverters.Or}">
											<Binding Path="HasBrightnessAdjustment"/>
											<Binding Path="HasContrastAdjustment"/>
											<Binding Path="HasHighlightAdjustment"/>
											<Binding Path="HasShadowAdjustment"/>
											<Binding Path="HasWarmthAdjustment"/>
											<Binding Path="HasTintAdjustment"/>
											<Binding Path="HasColorAdjustment"/>
											<Binding Path="HasSaturationAdjustment"/>
											<Binding Path="HasVibranceAdjustment"/>
										</MultiBinding>
									</Image.IsVisible>
								</Image>
							</Panel>
							<Image asControls:ToolbarElement.Role="Icon" Source="{StaticResource Image/Icon.ImageFilter.Light}" IsVisible="{Binding $parent[ToggleButton].IsChecked}"/>
						</Panel>
					</ToggleButton>

				</StackPanel>
			</Border>

		</Grid>

		<!-- Status bar -->
		<Panel Grid.Row="2">
			<Border Background="{x:Null}" Classes="StatusBar">

				<ia:Interaction.Behaviors>
					<iaCore:DataTriggerBehavior Binding="{Binding #root.StatusBarState}" Value="Inactive">
						<iaCore:ChangePropertyAction PropertyName="Background" Value="{StaticResource Brush/SessionControl.StatusBar.Background.Inactive}"/>
					</iaCore:DataTriggerBehavior>
					<iaCore:DataTriggerBehavior Binding="{Binding #root.StatusBarState}" Value="Error">
						<iaCore:ChangePropertyAction PropertyName="Background" Value="{StaticResource Brush/SessionControl.StatusBar.Background.Error}"/>
					</iaCore:DataTriggerBehavior>
					<iaCore:DataTriggerBehavior Binding="{Binding #root.StatusBarState}" Value="Active">
						<iaCore:ChangePropertyAction PropertyName="Background" Value="{StaticResource Brush/StatusBar.Background}"/>
					</iaCore:DataTriggerBehavior>
				</ia:Interaction.Behaviors>
				
				<Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">

					<!-- Reserve -->
					<TextBlock Grid.ColumnSpan="2" asControls:StatusBarElement.Role="Label" Text="{asXaml:StringResource SessionControl.NoSourceFileOpened}" Opacity="0"/>

					<!-- Left part -->
					<StackPanel ClipToBounds="True" Orientation="Horizontal">

						<!-- File actions -->
						<StackPanel Orientation="Horizontal">
							<TextBlock IsVisible="{Binding !IsSourceOpened}" asControls:StatusBarElement.Role="Label" Text="{asXaml:StringResource SessionControl.NoSourceFileOpened}"/>
							<ToggleButton Name="fileActionsButton" Command="{Binding #root.ShowFileActions}" IsVisible="{Binding SourceFileName, Converter={x:Static aConverters:ObjectConverters.IsNotNull}}" MaxWidth="{StaticResource Double/SessionControl.StatusBar.FileActions.MaxWidth}" asControls:StatusBarElement.Role="Button">
								<StackPanel Orientation="Horizontal">
									<Image asControls:StatusBarElement.Role="IconWithLabel">
										<DrawingImage>
											<GeometryDrawing Brush="{DynamicResource Brush/StatusBar.Foreground}" Geometry="{StaticResource Geometry/Icon.File.Outline}"/>
										</DrawingImage>
									</Image>
									<TextBlock asControls:StatusBarElement.Role="Label" Text="{Binding SourceSizeString}"/>
									<Image asControls:StatusBarElement.Role="DropDownIcon">
										<DrawingImage>
											<GeometryDrawing Brush="{DynamicResource Brush/StatusBar.Foreground}" Geometry="{StaticResource Geometry/Icon.DropDown.Up}"/>
										</DrawingImage>
									</Image>
								</StackPanel>
							</ToggleButton>
							<Separator IsVisible="{asXaml:OrBindings
								{Binding !IsSourceOpened},
								{Binding SourceFileName, Converter={x:Static aConverters:ObjectConverters.IsNotNull}}
							}" asControls:StatusBarElement.Role="Separator"/>
						</StackPanel>

						<!-- Source data size -->
						<StackPanel Background="{x:Static Brushes.Transparent}" Orientation="Horizontal" ToolTip.Placement="Left" ToolTip.Tip="{asXaml:StringResource SessionControl.SourceDataSize}">
							<StackPanel.IsVisible>
								<MultiBinding Converter="{x:Static aConverters:BoolConverters.And}">
									<Binding Path="HasRenderedImage"/>
									<Binding Path="HasSourceDataSize"/>
								</MultiBinding>
							</StackPanel.IsVisible>
							<Image asControls:StatusBarElement.Role="IconWithLabel">
								<DrawingImage>
									<GeometryDrawing Brush="{DynamicResource Brush/StatusBar.Foreground}" Geometry="{StaticResource Geometry/Icon.BinaryData}"/>
								</DrawingImage>
							</Image>
							<TextBlock asControls:StatusBarElement.Role="Label" Text="{Binding SourceDataSize, StringFormat={}{0:N0} }"/>
							<TextBlock asControls:StatusBarElement.Role="Label" Text="{asXaml:StringResource Common.Bytes}"/>
							<Separator asControls:StatusBarElement.Role="Separator"/>
						</StackPanel>

						<!-- Screen color space -->
						<Button Command="{Binding #root.ShowScreenColorSpaceInfo}" IsVisible="{Binding IsColorSpaceManagementEnabled}" asControls:StatusBarElement.Role="Button" ToolTip.Placement="Left" ToolTip.Tip="{asXaml:StringResource SessionControl.ScreenColorSpace}">
							<StackPanel Orientation="Horizontal">
								<Image asControls:StatusBarElement.Role="IconWithLabel">
									<DrawingImage>
										<GeometryDrawing Brush="{DynamicResource Brush/StatusBar.Foreground}" Geometry="{StaticResource Geometry/Icon.Screen}"/>
									</DrawingImage>
								</Image>
								<TextBlock asControls:StatusBarElement.Role="Label" Text="{Binding ((appViewModels:Workspace)Owner).EffectiveScreenColorSpace, Converter={x:Static appConverters:ColorSpaceToStringConverter.Default}, FallbackValue={x:Null}}"/>
							</StackPanel>
						</Button>
						<Separator IsVisible="{Binding IsColorSpaceManagementEnabled}" asControls:StatusBarElement.Role="Separator"/>

					</StackPanel>

					<!-- Right part -->
					<StackPanel Grid.Column="1" Orientation="Horizontal">
						
						<!-- Saving image -->
						<StackPanel IsVisible="{Binding IsSavingImage}" Orientation="Horizontal">
							<Separator asControls:StatusBarElement.Role="Separator"/>
							<Image asControls:StatusBarElement.Role="IconWithLabel">
								<DrawingImage>
									<GeometryDrawing Brush="{DynamicResource Brush/StatusBar.Foreground}" Geometry="{StaticResource Geometry/Icon.Save.Outline}"/>
								</DrawingImage>
							</Image>
							<TextBlock asControls:StatusBarElement.Role="Label" Text="{asXaml:StringResource SessionControl.SavingRenderedImage}"/>
						</StackPanel>

						<!-- Filtering image -->
						<StackPanel IsVisible="{Binding IsFilteringRenderedImage}" Orientation="Horizontal">
							<Separator asControls:StatusBarElement.Role="Separator"/>
							<Image asControls:StatusBarElement.Role="IconWithLabel">
								<DrawingImage>
									<GeometryDrawing Brush="{DynamicResource Brush/StatusBar.Foreground}" Geometry="{StaticResource Geometry/Icon.ImageFilter}"/>
								</DrawingImage>
							</Image>
							<TextBlock asControls:StatusBarElement.Role="Label" Text="{asXaml:StringResource SessionControl.FilteringRenderedImage}"/>
						</StackPanel>

						<!-- Rendering image, hidden when playing frames to prevent it from flashing -->
						<StackPanel IsVisible="{asXaml:AndBindings
						                           {Binding IsRenderingImage},
						                           {Binding !IsPlayingFrames}
						                       }" 
						            Orientation="Horizontal">
							<Separator asControls:StatusBarElement.Role="Separator"/>
							<Image asControls:StatusBarElement.Role="IconWithLabel">
								<DrawingImage>
									<GeometryDrawing Brush="{DynamicResource Brush/StatusBar.Foreground}" Geometry="{StaticResource Geometry/Icon.Waiting.Outline}"/>
								</DrawingImage>
							</Image>
							<Panel>
								<TextBlock IsVisible="{Binding IsConvertingColorSpace}" asControls:StatusBarElement.Role="Label" Text="{asXaml:StringResource SessionControl.ConvertingColorSpace}"/>
								<TextBlock IsVisible="{Binding !IsConvertingColorSpace}" asControls:StatusBarElement.Role="Label" Text="{asXaml:StringResource SessionControl.RenderingImage}"/>
							</Panel>
						</StackPanel>

						<!-- Process info -->
						<StackPanel IsVisible="{Binding #root.ShowProcessInfo}" Orientation="Horizontal">
							
							<!-- UI response duration -->
							<StackPanel IsVisible="{Binding Source={x:Static app:App.Current}, Path=(as:AppSuiteApplication).IsDebugMode}" Orientation="Horizontal">
								<Separator asControls:StatusBarElement.Role="Separator"/>
								<Image asControls:StatusBarElement.Role="IconWithLabel">
									<DrawingImage>
										<GeometryDrawing Brush="{DynamicResource Brush/StatusBar.Foreground}" Geometry="{StaticResource Geometry/Icon.Speed.Outline}"/>
									</DrawingImage>
								</Image>
								<Panel>
									<TextBlock Opacity="0" asControls:StatusBarElement.Role="Label" Text="000 ms   "/>
									<TextBlock HorizontalAlignment="Left" asControls:StatusBarElement.Role="Label" Text="{Binding Source={x:Static app:App.Current}, Path=(as:AppSuiteApplication).ProcessInfo.UIResponseDuration, Converter={x:Static asConverters:TimeSpanConverter.Default}}" ToolTip.Placement="Left" ToolTip.Tip="{asXaml:StringResource SessionControl.UIResponseDuration}"/>
								</Panel>
							</StackPanel>

							<!-- CPU usage -->
							<Separator asControls:StatusBarElement.Role="Separator"/>
							<Image asControls:StatusBarElement.Role="IconWithLabel">
								<DrawingImage>
									<GeometryDrawing Brush="{DynamicResource Brush/StatusBar.Foreground}" Geometry="{StaticResource Geometry/Icon.Cpu}"/>
								</DrawingImage>
							</Image>
							<Panel>
								<TextBlock Opacity="0" asControls:StatusBarElement.Role="Label" Text="00.0%"/>
								<TextBlock HorizontalAlignment="Left" asControls:StatusBarElement.Role="Label" Text="{Binding Source={x:Static app:App.Current}, Path=(as:AppSuiteApplication).ProcessInfo.CpuUsagePercentage, StringFormat={}{0:F1}%}" ToolTip.Placement="Left" ToolTip.Tip="{asXaml:StringResource SessionControl.CpuUsage}"/>
							</Panel>

							<!-- Memory usage -->
							<Separator asControls:StatusBarElement.Role="Separator"/>
							<Image asControls:StatusBarElement.Role="IconWithLabel">
								<DrawingImage>
									<GeometryDrawing Brush="{DynamicResource Brush/StatusBar.Foreground}" Geometry="{StaticResource Geometry/Icon.Memory.Outline}"/>
								</DrawingImage>
							</Image>
							<Panel>
								<TextBlock Opacity="0" asControls:StatusBarElement.Role="Label" Text="000.0%"/>
								<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
									<TextBlock asControls:StatusBarElement.Role="Label" Text="{Binding RenderedImagesMemoryUsage, Converter={x:Static asConverters:FileSizeConverter.Default}}" ToolTip.Placement="Left" ToolTip.Tip="{asXaml:StringResource SessionControl.RenderedImagesMemoryUsage}"/>
									<TextBlock asControls:StatusBarElement.Role="Label" Text="{Binding TotalRenderedImagesMemoryUsage, Converter={x:Static asConverters:FileSizeConverter.Default}, StringFormat={}/{0}}" ToolTip.Placement="Left" ToolTip.Tip="{asXaml:StringResource SessionControl.TotalRenderedImagesMemoryUsage}"/>
									<TextBlock asControls:StatusBarElement.Role="Label" Text="{Binding Source={x:Static app:App.Current}, Path=(as:AppSuiteApplication).ProcessInfo.PrivateMemoryUsage, Converter={x:Static asConverters:FileSizeConverter.Default}, StringFormat={}/{0}}" ToolTip.Placement="Left" ToolTip.Tip="{asXaml:StringResource SessionControl.PrivateMemoryUsage}"/>
								</StackPanel>
							</Panel>

						</StackPanel>

					</StackPanel>
					
				</Grid>
			</Border>
			<Border BorderBrush="{DynamicResource Brush/StatusBar.Border}" BorderThickness="0,1,0,0"/>
		</Panel>
		
	</Grid>
</UserControl>
